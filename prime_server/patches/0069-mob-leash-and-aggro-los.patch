+   LeashHome()
+   "Prime leash: the spot it walks back to after giving up a chase. Taken when it takes a target; an older spot is kept unless the mob stands within 8 squares of it."
+   {
+      local iDr, iDc;
+
+      if piHomeRow <> 0
+      {
+         iDr = piRow - piHomeRow;
+         iDc = piCol - piHomeCol;
+         if iDr * iDr + iDc * iDc > 64
+         {
+            return;
+         }
+      }
+
+      piHomeRow = piRow;
+      piHomeCol = piCol;
+      piHomeFineRow = piFine_row;
+      piHomeFineCol = piFine_col;
+
+      return;
+   }
+
+   LeashTick()
+   "Prime leash, once per chase tick: TRUE when the mob gave its target up (it made no progress towards it for piMobLeashSecs seconds: not in reach, not closer by a square, nobody hurt). It ignores that target for 30 seconds, heals if the rule says so, drops its aggro and walks back to where it stood."
+   {
+      local oPrime, iSecs, iDist, oTarget, iFoeHp, iMyHp;
+
+      oPrime = Send(SYS,@GetPrime);
+      iSecs = Send(oPrime,@MobLeashSecs);
+      if iSecs <= 0 OR poTarget = $ OR poOwner = $
+      {
+         return FALSE;
+      }
+
+      oTarget = poTarget;
+      iDist = Send(self,@SquaredFineDistanceTo3D,#what=oTarget);
+      iFoeHp = Send(oTarget,@GetHealth);
+      iMyHp = Send(self,@GetHealth);
+      if piLeashAt = 0 OR Send(self,@CanReach,#what=oTarget) OR iDist + FINENESS_SQUARED < piLeashDist
+         OR iFoeHp < piLeashFoeHp OR iMyHp < piLeashMyHp
+      {
+         piLeashDist = iDist;
+         piLeashAt = GetTime();
+         piLeashFoeHp = iFoeHp;
+         piLeashMyHp = iMyHp;
+
+         return FALSE;
+      }
+
+      piLeashFoeHp = iFoeHp;
+      piLeashMyHp = iMyHp;
+      if GetTime() - piLeashAt < iSecs
+      {
+         return FALSE;
+      }
+
+      // it gives up
+      poLeashIgnore = oTarget;
+      piLeashIgnoreUntil = GetTime() + 30;
+      piLeashAt = 0;
+      Debug("LEASH: ",self," gives up on ",oTarget," after ",iSecs," s, back to ",piHomeRow,piHomeCol);
+      if Send(oPrime,@MobLeashHeal)
+      {
+         piHit_points = piMax_hit_points * 100;
+      }
+
+      Send(self,@EnterStateMove);
+      if piHomeRow <> 0
+      {
+         Send(self,@GotoCoords,#iRow=piHomeRow,#iCol=piHomeCol,#iFineRow=piHomeFineRow,#iFineCol=piHomeFineCol);
+      }
+
+      return TRUE;
+   }
+
+   IsLeashIgnoring(what = $)
+   "Prime leash: is this the target it gave up on a moment ago?"
+   {
+      return what <> $ AND what = poLeashIgnore AND GetTime() < piLeashIgnoreUntil;
+   }
+
