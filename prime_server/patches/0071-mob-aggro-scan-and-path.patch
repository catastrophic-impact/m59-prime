+   AggroScan()
+   "Prime (rule pbMobAggroScan): a monster that is moving about with no target looks for one once a second, as it does when someone moves: a player, playerbot or companion that stands still in its sight is noticed too. TRUE when it took a target."
+   {
+      local iNow, i, oWho, iVision, iDist;
+
+      if NOT Send(Send(SYS,@GetPrime),@MobAggroScan)
+         OR poOwner = $ OR poBrain = $ OR NOT (piState & STATE_MOVE)
+      {
+         return FALSE;
+      }
+
+      iNow = GetTime();
+      if iNow = piScanAt
+      {
+         return FALSE;
+      }
+
+      piScanAt = iNow;
+      iVision = Send(self,@GetVisionDistance);
+      iVision = iVision * iVision;
+      foreach i in Send(poOwner,@GetHolderActive)
+      {
+         oWho = First(i);
+         if oWho <> self AND (IsClass(oWho,&User) OR (IsClass(oWho,&Monster) AND Send(oWho,@IsCompanion)))
+         {
+            iDist = Send(self,@SqFineDistToVision,#what=oWho) / FINENESS_SQUARED;
+            if iDist <= iVision
+            {
+               Send(poBrain,@SomethingMoved,#mob=self,#state=piState,#what=oWho,
+                     #new_row=Send(oWho,@GetRow),#new_col=Send(oWho,@GetCol),
+                     #fine_row=Send(oWho,@GetFineRow),#fine_col=Send(oWho,@GetFineCol));
+               if poTarget <> $
+               {
+                  return TRUE;
+               }
+            }
+         }
+      }
+
+      return FALSE;
+   }
+
