+// A way is only as good as its steps: BSPCanMoveInRoom looks at the END of a move for the wall margin, so a long move can graze a wall that its 16-fine-unit
+// steps would be refused at. The walker moves in steps of 16 KOD fine units (256 ROO units): test every one.
+static Wall* fp_lastWall = NULL;   // the wall that refused the last failed FPWalk (NULL: an object or creature)
+
+static bool FPWalk(room_type* Room, V2* A, V2* B, int ObjectID)
+{
+   fp_lastWall = NULL;
+   // exactly the walker's steps (PlayerBot.PathStep): integer KOD fine units, the larger axis moves 16 per step
+   Wall* blockWall = NULL;
+   int ax = (int)roundf(A->X / 16.0f), ay = (int)roundf(A->Y / 16.0f);
+   const int bx = (int)roundf(B->X / 16.0f), by = (int)roundf(B->Y / 16.0f);
+   V2 prev = *A;
+   for (int k = 0; k < 4000; k++)
+   {
+      int dx = bx - ax, dy = by - ay;
+      int dist = abs(dx) > abs(dy) ? abs(dx) : abs(dy);
+      if (dist == 0)
+         return true;
+      int nx, ny;
+      if (dist <= 16)
+      {
+         nx = bx;
+         ny = by;
+      }
+      else
+      {
+         nx = ax + dx * 16 / dist;
+         ny = ay + dy * 16 / dist;
+      }
+      V2 next;
+      next.X = (float)nx * 16.0f;
+      next.Y = (float)ny * 16.0f;
+      blockWall = NULL;
+      if (!BSPCanMoveInRoom(Room, &prev, &next, ObjectID, false, &blockWall))
+      {
+         fp_lastWall = blockWall;
+         return false;
+      }
+      prev = next;
+      ax = nx;
+      ay = ny;
+      if (nx == bx && ny == by)
+         return true;
+   }
+   return false;
+}
