+// 1 = a way (P set), 0 = none, -1 = no grid for this room (use the coarse search)
+/* PRIME (patch 0075): is the square this point lies in one the walker was told to keep off? */
+static bool FPPointAvoided(const V2* v)
+{
+   if (g_AvoidN <= 0)
+      return false;
+   int r = ROOCOORDTOGRIDBIG(v->Y), c = ROOCOORDTOGRIDBIG(v->X);
+   for (int i = 0; i < g_AvoidN; i++)
+      if (g_AvoidRow[i] == r && g_AvoidCol[i] == c)
+         return true;
+   return false;
+}
