+/* PRIME navmesh-style grid: per room, once, a fine map (1/8 square cells) of which of the 8     */
+/* neighbours a body can walk to by the server's own wall rules (BSPCanMoveInRoom, the margin   */
+/* from the walls already inside). The path search then runs over these links without asking the */
+/* BSP again. Built from the static room only (creatures and loose objects are left out: the    */
+/* walker meets those and plans again). Guardrails: cell cap, build time cap, one cache per room.*/
+/*********************************************************************************************/
+#define FPG_CELL           128.0f      // ROO units: an eighth of a square
+#define FPG_MAX_CELLS      1500000     // largest grid built
+#define FPG_BUILD_MS       15000       // longest build
+#define FPG_MAX_EXPAND     900000
+#define FPG_MAX_MS         250
+#define FPG_GOAL_RADIUS    1536.0f
+
+struct FPGrid
+{
+   int ncols, nrows;
+   std::vector<unsigned char> links;      // bit d: the way to neighbour d (E,SE,S,SW,W,NW,N,NE) is open
+   std::vector<float> g;                  // scratch, valid where stamp == cur
+   std::vector<int> parent;
+   std::vector<unsigned int> stamp;
+   std::vector<unsigned char> closed;
+   unsigned int cur;
+   bool ok;
+};
+const char* g_pathRoomName = "";
+static std::map<int, FPGrid*> fp_grids;
+static unsigned int fp_grid_built = 0, fp_grid_failed = 0;
+
+static const int FPG_DC[8] = { 1, 1, 0, -1, -1, -1, 0, 1 };
+static const int FPG_DR[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+
+static FPGrid* FPGetGrid(room_type* Room)
+{
+   auto it = fp_grids.find(Room->roomdata_id);
+   if (it != fp_grids.end())
+      return it->second->ok ? it->second : NULL;
+
+   FPGrid* gr = new FPGrid();
+   gr->ok = false;
+   gr->cur = 0;
+   fp_grids[Room->roomdata_id] = gr;
+
+   gr->ncols = (int)((float)Room->cols * ROOFINENESS / FPG_CELL) + 1;
+   gr->nrows = (int)((float)Room->rows * ROOFINENESS / FPG_CELL) + 1;
+   if (gr->ncols <= 1 || gr->nrows <= 1 || (long long)gr->ncols * gr->nrows > FPG_MAX_CELLS)
+   {
+      ++fp_grid_failed;
+      eprintf("BSPFindPathStep grid: room %i too big or empty (%d x %d cells)\n", Room->roomdata_id, gr->ncols, gr->nrows);
+      return NULL;
+   }
+
+   const int total = gr->ncols * gr->nrows;
+   gr->links.assign(total, 0);
+   BlockerNode* saved = Room->Blocker;
+   Room->Blocker = NULL;                  // static room only
+   const int fpSavedAvoid = g_AvoidN;     // PRIME (patch 0075): the cached grid is the room's pure geometry; the avoid list is applied in the search, not baked in
+   g_AvoidN = 0;
+   clock_t t0 = clock();
+   Wall* bw = NULL;
+   bool timedOut = false;
+   for (int r = 0; r < gr->nrows && !timedOut; r++)
+   {
+      for (int c = 0; c < gr->ncols; c++)
+      {
+         V2 a;
+         a.X = ((float)c + 0.5f) * FPG_CELL;
+         a.Y = ((float)r + 0.5f) * FPG_CELL;
+         unsigned char m = 0;
+         for (int d = 0; d < 8; d++)
+         {
+            int nc = c + FPG_DC[d], nr = r + FPG_DR[d];
+            if (nc < 0 || nr < 0 || nc >= gr->ncols || nr >= gr->nrows)
+               continue;
+            V2 b;
+            b.X = ((float)nc + 0.5f) * FPG_CELL;
+            b.Y = ((float)nr + 0.5f) * FPG_CELL;
+            bw = NULL;
+            if (BSPCanMoveInRoom(Room, &a, &b, 0, false, &bw))
+               m |= (unsigned char)(1 << d);
+         }
+         gr->links[r * gr->ncols + c] = m;
+      }
+      if ((r & 15) == 0 && (clock() - t0) * 1000 / CLOCKS_PER_SEC > FPG_BUILD_MS)
+         timedOut = true;
+   }
+   Room->Blocker = saved;
+   g_AvoidN = fpSavedAvoid;
+   unsigned int ms = (unsigned int)((clock() - t0) * 1000 / CLOCKS_PER_SEC);
+   if (timedOut)
+   {
+      ++fp_grid_failed;
+      eprintf("BSPFindPathStep grid: room %i build ran out of time (%u ms), not used\n", Room->roomdata_id, ms);
+      return NULL;
+   }
+
+   // DEBUG DUMP for the room viewer (scripts/roomview.py): while the file dumpgrid.txt exists in the server folder, every grid built is written to
+   // pathgrid_<room file name>.bin: "PGR1", ncols, nrows, cell size (ints), links (1 byte per cell), floor height of each cell centre (float, NaN outside any sector)
+   {
+      FILE* df = fopen("dumpgrid.txt", "rb");
+      if (df)
+      {
+         fclose(df);
+         char fname[300];
+         snprintf(fname, sizeof(fname), "pathgrid_%s.bin", g_pathRoomName);
+         FILE* out = fopen(fname, "wb");
+         if (out)
+         {
+            int hdr[3] = { gr->ncols, gr->nrows, (int)FPG_CELL };
+            fwrite("PGR1", 1, 4, out);
+            fwrite(hdr, sizeof(int), 3, out);
+            fwrite(gr->links.data(), 1, gr->links.size(), out);
+            std::vector<float> hts(total);
+            for (int r = 0; r < gr->nrows; r++)
+               for (int c = 0; c < gr->ncols; c++)
+               {
+                  V2 pt;
+                  pt.X = ((float)c + 0.5f) * FPG_CELL;
+                  pt.Y = ((float)r + 0.5f) * FPG_CELL;
+                  float hf = 0, hfwd = 0, hc = 0;
+                  BspLeaf* leaf = NULL;
+                  hts[r * gr->ncols + c] = BSPGetHeight(Room, &pt, &hf, &hfwd, &hc, &leaf) ? hf : NAN;
+               }
+            fwrite(hts.data(), sizeof(float), hts.size(), out);
+            fclose(out);
+            eprintf("BSPFindPathStep grid: dumped %s\n", fname);
+         }
+      }
+   }
+
+   gr->g.assign(total, 0.0f);
+   gr->parent.assign(total, -1);
+   gr->stamp.assign(total, 0);
+   gr->closed.assign(total, 0);
+   gr->ok = true;
+   ++fp_grid_built;
+   eprintf("BSPFindPathStep grid: room %i built, %d x %d cells in %u ms\n", Room->roomdata_id, gr->ncols, gr->nrows, ms);
+   return gr;
+}
