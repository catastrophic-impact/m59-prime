+static int FPGridSearch(room_type* Room, V2* S, V2* E, V2* P, int ObjectID, unsigned int* explored, int* total)
+{
+   FPGrid* gr = FPGetGrid(Room);
+   if (!gr)
+      return -1;
+   *total = gr->ncols * gr->nrows;
+   *explored = 0;
+
+   auto cellOf = [&](const V2* v, int& c, int& r) {
+      c = (int)(v->X / FPG_CELL); r = (int)(v->Y / FPG_CELL);
+      if (c < 0) c = 0; if (c >= gr->ncols) c = gr->ncols - 1;
+      if (r < 0) r = 0; if (r >= gr->nrows) r = gr->nrows - 1;
+   };
+   auto centre = [&](int cell) -> V2 {
+      V2 v;
+      v.X = ((float)(cell % gr->ncols) + 0.5f) * FPG_CELL;
+      v.Y = ((float)(cell / gr->ncols) + 0.5f) * FPG_CELL;
+      return v;
+   };
+
+   // start: the cell the body stands in, or a nearby one it can walk to
+   int sc, sr;
+   cellOf(S, sc, sr);
+   int startCell = -1;
+   float bestD = 1e30f;
+   for (int dr = -2; dr <= 2; dr++)
+      for (int dc = -2; dc <= 2; dc++)
+      {
+         int c = sc + dc, r = sr + dr;
+         if (c < 0 || r < 0 || c >= gr->ncols || r >= gr->nrows)
+            continue;
+         int cell = r * gr->ncols + c;
+         V2 cc = centre(cell);
+         float dx = cc.X - S->X, dy = cc.Y - S->Y, dd = dx * dx + dy * dy;
+         if (dd < bestD && (dd < 1.0f || FPWalk(Room, S, &cc, ObjectID)))
+         {
+            bestD = dd;
+            startCell = cell;
+         }
+      }
+   if (startCell < 0)
+      return 0;
+
+   ++gr->cur;
+   if (gr->cur == 0xFFFFFFFFu)
+   {
+      std::fill(gr->stamp.begin(), gr->stamp.end(), 0);
+      gr->cur = 1;
+   }
+   const unsigned int cur = gr->cur;
+
+   struct Item { float f; int cell; };
+   struct Cmp { bool operator()(const Item& a, const Item& b) const { return a.f > b.f; } };
+   std::priority_queue<Item, std::vector<Item>, Cmp> open;
+   auto h = [&](int cell) -> float {
+      V2 c = centre(cell);
+      float dx = c.X - E->X, dy = c.Y - E->Y;
+      return sqrtf(dx * dx + dy * dy);
+   };
+   auto touch = [&](int cell) {
+      if (gr->stamp[cell] != cur) { gr->stamp[cell] = cur; gr->g[cell] = 1e30f; gr->parent[cell] = -1; gr->closed[cell] = 0; }
+   };
+
+   touch(startCell);
+   gr->g[startCell] = 0.0f;
+   open.push({ h(startCell), startCell });
+   clock_t t0 = clock();
+   int found = -1;
+   unsigned int expanded = 0;
+   while (!open.empty())
+   {
+      Item it = open.top();
+      open.pop();
+      int cur2 = it.cell;
+      if (gr->closed[cur2])
+         continue;
+      gr->closed[cur2] = 1;
+      ++expanded;
+
+      V2 cc = centre(cur2);
+      float gx = cc.X - E->X, gy = cc.Y - E->Y;
+      if (gx * gx + gy * gy <= FPG_GOAL_RADIUS * FPG_GOAL_RADIUS)
+      {
+         found = cur2;
+         break;
+      }
+      if (expanded >= (unsigned int)FPG_MAX_EXPAND || ((expanded & 1023) == 0 && (clock() - t0) * 1000 / CLOCKS_PER_SEC > FPG_MAX_MS))
+         break;
+
+      const int cc_c = cur2 % gr->ncols, cc_r = cur2 / gr->ncols;
+      const unsigned char m = gr->links[cur2];
+      for (int d = 0; d < 8; d++)
+      {
+         if (!(m & (1 << d)))
+            continue;
+         int nb = (cc_r + FPG_DR[d]) * gr->ncols + (cc_c + FPG_DC[d]);
+         touch(nb);
+         if (gr->closed[nb])
+            continue;
+         { V2 nbc = centre(nb); if (FPPointAvoided(&nbc) && !FPPointAvoided(&cc)) continue; }   // PRIME (patch 0075): do not enter a door square
+         float ng = gr->g[cur2] + ((d & 1) ? 181.0f : 128.0f);
+         if (ng < gr->g[nb])
+         {
+            gr->g[nb] = ng;
+            gr->parent[nb] = cur2;
+            open.push({ ng + h(nb), nb });
+         }
+      }
+   }
+   *explored = expanded;
+   if (found < 0)
+      return 0;
+
