+/*********************************************************************************************/
+/* BSPFindPathStep:  PRIME. Finds a walkable way from S to E with A* over a grid of half-square */
+/*                   cells, every link judged by BSPCanMoveInRoom (the client's own walk rules, */
+/*                   walls, heights and solid objects), and returns in P the farthest point of  */
+/*                   that way that can be walked to in a straight line from S. False when there */
+/*                   is no way, the room is too big or the search ran out of its budget.       */
+/*                   Guardrails: cell and expansion caps, a time limit, bounds checks, capped   */
+/*                   log (a few lines, then one summary per 1000 calls).                        */
+/*********************************************************************************************/
+#define FP_CELL            512.0f      // cell size in ROO units (half a square)
+#define FP_MAX_CELLS       250000      // largest grid this will search
+#define FP_MAX_EXPAND      80000       // most cells expanded in one search
+#define FP_MAX_MS          60          // time limit of one search, ms
+#define FP_MAX_LOG         25          // detailed log lines for the lifetime of the server
+
+static unsigned int fp_calls = 0, fp_found = 0, fp_direct = 0, fp_nopath = 0, fp_aborted = 0, fp_toobig = 0, fp_logged = 0;
+static unsigned int fp_ms_total = 0, fp_ms_max = 0;
+
+static void FPLog(const char* what, room_type* Room, V2* S, V2* E, unsigned int expanded, unsigned int ms)
+{
+   if (fp_logged >= FP_MAX_LOG)
+      return;
+   ++fp_logged;
+   eprintf("BSPFindPathStep %s: room %i from (%.0f,%.0f) to (%.0f,%.0f) expanded %u in %u ms%s\n",
+      what, Room ? Room->roomdata_id : -1, S ? S->X : 0.0f, S ? S->Y : 0.0f, E ? E->X : 0.0f, E ? E->Y : 0.0f, expanded, ms,
+      fp_logged == FP_MAX_LOG ? " (detail log full: only summaries from now on)" : "");
+}
+
+bool BSPFindPathStep(room_type* Room, V2* S, V2* E, V2* P, int ObjectID)
+{
+   if (!Room | !S | !E | !P)
+      return false;
+
+   ++fp_calls;
+   if ((fp_calls % 1000) == 0)
+      eprintf("BSPFindPathStep summary: %u calls, %u found (%u straight), %u no way, %u aborted, %u too big, avg %u ms, max %u ms\n",
+         fp_calls, fp_found, fp_direct, fp_nopath, fp_aborted, fp_toobig, fp_ms_total / fp_calls, fp_ms_max);
+
+   Wall* blockWall = NULL;
+
+   // 1) a straight walk
+   if (BSPCanMoveInRoom(Room, S, E, ObjectID, false, &blockWall))
+   {
+      *P = *E;
+      ++fp_found;
+      ++fp_direct;
+      return true;
+   }
+
+   const int ncols = Room->cols * 2 + 2;
+   const int nrows = Room->rows * 2 + 2;
+   if (ncols <= 2 || nrows <= 2 || (long long)ncols * nrows > FP_MAX_CELLS)
+   {
+      ++fp_toobig;
+      FPLog("room too big or empty", Room, S, E, 0, 0);
+      return false;
+   }
+
+   auto cellOf = [&](const V2* v) -> int {
+      int c = (int)(v->X / FP_CELL), r = (int)(v->Y / FP_CELL);
+      if (c < 0) c = 0; if (c >= ncols) c = ncols - 1;
+      if (r < 0) r = 0; if (r >= nrows) r = nrows - 1;
+      return r * ncols + c;
+   };
+   auto centre = [&](int cell) -> V2 {
+      V2 v;
+      v.X = (float)(cell % ncols) * FP_CELL + FP_CELL * 0.5f;
+      v.Y = (float)(cell / ncols) * FP_CELL + FP_CELL * 0.5f;
+      return v;
+   };
+
+   const int total = ncols * nrows;
+   std::vector<float> g(total, 1e30f);
+   std::vector<int> parent(total, -1);
+   std::vector<unsigned char> state(total, 0);   // 0 new, 1 open, 2 closed
+   const int startCell = cellOf(S), endCell = cellOf(E);
+
+   struct Item { float f; int cell; };
+   struct Cmp { bool operator()(const Item& a, const Item& b) const { return a.f > b.f; } };
+   std::priority_queue<Item, std::vector<Item>, Cmp> open;
+
+   V2 endc = *E;
+   auto h = [&](int cell) -> float {
+      V2 c = centre(cell);
+      float dx = c.X - endc.X, dy = c.Y - endc.Y;
+      return sqrtf(dx * dx + dy * dy);
+   };
+
+   g[startCell] = 0.0f;
+   state[startCell] = 1;
+   open.push({ h(startCell), startCell });
+
+   static const int DC[8] = { 1, 1, 0, -1, -1, -1, 0, 1 };
+   static const int DR[8] = { 0, 1, 1, 1, 0, -1, -1, -1 };
+
+   clock_t t0 = clock();
+   unsigned int expanded = 0;
+   int found = -1;
+   bool aborted = false;
+
+   while (!open.empty())
+   {
+      Item it = open.top();
+      open.pop();
+      int cur = it.cell;
+      if (state[cur] == 2)
+         continue;
+      state[cur] = 2;
+      ++expanded;
+
+      // from the exact start point for the first cell, else from the cell's centre
+      V2 from = (cur == startCell) ? *S : centre(cur);
+
+      if (cur == endCell)
+      {
+         // the last link goes to the exact goal
+         if (BSPCanMoveInRoom(Room, &from, E, ObjectID, false, &blockWall))
+         {
+            found = cur;
+            break;
+         }
+      }
+
+      if (expanded >= FP_MAX_EXPAND || ((expanded & 255) == 0 && (clock() - t0) * 1000 / CLOCKS_PER_SEC > FP_MAX_MS))
+      {
+         aborted = true;
+         break;
+      }
+
+      const int cc = cur % ncols, cr = cur / ncols;
+      for (int d = 0; d < 8; d++)
+      {
+         int nc = cc + DC[d], nr = cr + DR[d];
+         if (nc < 0 || nr < 0 || nc >= ncols || nr >= nrows)
+            continue;
+         int nb = nr * ncols + nc;
+         if (state[nb] == 2)
+            continue;
+         V2 to = centre(nb);
+         float dx = to.X - from.X, dy = to.Y - from.Y;
+         float ng = g[cur] + sqrtf(dx * dx + dy * dy);
+         if (ng >= g[nb])
+            continue;
+         if (!BSPCanMoveInRoom(Room, &from, &to, ObjectID, false, &blockWall))
+            continue;
+         g[nb] = ng;
+         parent[nb] = cur;
+         state[nb] = 1;
+         open.push({ ng + h(nb), nb });
+      }
+   }
+
+   unsigned int ms = (unsigned int)((clock() - t0) * 1000 / CLOCKS_PER_SEC);
+   fp_ms_total += ms;
+   if (ms > fp_ms_max)
+      fp_ms_max = ms;
+
+   if (found < 0)
+   {
+      if (aborted)
+      {
+         ++fp_aborted;
+         FPLog("aborted (budget)", Room, S, E, expanded, ms);
+      }
+      else
+      {
+         ++fp_nopath;
+         FPLog("no way", Room, S, E, expanded, ms);
+      }
+      return false;
+   }
+
+   // the way, from the goal back to the start; then the farthest point of it that can be walked to in a straight line from S
+   std::vector<V2> way;
+   for (int c = found; c != -1 && way.size() < (size_t)total; c = parent[c])
+      way.push_back(centre(c));
+   // way[0] is the goal cell, way.back() the start cell
+   *P = way.size() > 1 ? way[way.size() - 2] : *E;
+   for (size_t i = 0; i + 1 < way.size(); i++)
+   {
+      if (BSPCanMoveInRoom(Room, S, &way[i], ObjectID, false, &blockWall))
+      {
+         *P = way[i];
+         break;
+      }
+   }
+
+   ++fp_found;
+   return true;
+}
+
