 /*
+ * C_SetBodyRadiusBSP: PRIME (patch 0074). SetBodyRadiusBSP(radius): sets the radius (roo units, 1024 = one square) round a body that blocks a move in BSPCanMoveInRoom /
+ *    BSPExplainMove / the path planner, and returns the OLD radius so the caller can put it back. 768 is the server default (monster rule), 256 what the client blocks a player with.
+ *    Bounded 64..1024; anything else is ignored (the current radius is returned).
+ */
+int C_SetBodyRadiusBSP(int object_id, local_var_type *local_vars,
+	int num_normal_parms, parm_node normal_parm_array[],
+	int num_name_parms, parm_node name_parm_array[])
+{
+	val_type ret_val, r_val;
+
+	ret_val.v.tag = TAG_INT;
+	ret_val.v.data = (int)g_BodyRadius;
+
+	if (num_normal_parms != 1)
+		return ret_val.int_val;
+
+	r_val = RetrieveValue(object_id, local_vars, normal_parm_array[0].type, normal_parm_array[0].value);
+	if (r_val.v.tag != TAG_INT || r_val.v.data < 64 || r_val.v.data > 1024)
+		return ret_val.int_val;
+
+	g_BodyRadius = (float)r_val.v.data;
+	g_BodyRadius2 = g_BodyRadius * g_BodyRadius;
+
+	return ret_val.int_val;
+}
+
