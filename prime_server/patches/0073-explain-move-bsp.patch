+/* BSPExplainMove: PRIME (patch 0073). The same verdict as BSPCanMoveInRoom, with the REASON.
+/*   returns 0 = allowed, 1 = a wall stops it (out = wall P1.X, P1.Y, P2.X, P2.Y in roo units),
+/*   2 = a body (blocker) stops it (out = object id, its X, its Y, 0), 3 = no room data / bad arguments.
+/*   Used only by the debug tools (ExplainMoveBSP); it never changes anything.
+/*********************************************************************************************/
+int BSPExplainMove(room_type* Room, V2* S, V2* E, int ObjectID, bool moveOutsideBSP, int out[4])
+{
+   out[0] = out[1] = out[2] = out[3] = 0;
+
+   if (!Room || Room->TreeNodesCount == 0 || !S || !E)
+      return 3;
+
+   if (ISZERO(S->X - E->X) && ISZERO(S->Y - E->Y))
+      return 0;
+
+   Wall* bw = NULL;
+   if (!moveOutsideBSP && !BSPCanMoveInRoomTree(&Room->TreeNodes[0], S, E, &bw))
+   {
+      if (bw)
+      {
+         out[0] = (int)bw->P1.X;
+         out[1] = (int)bw->P1.Y;
+         out[2] = (int)bw->P2.X;
+         out[3] = (int)bw->P2.Y;
+      }
+      return 1;
+   }
+
+   BlockerNode* blocker = Room->Blocker;
+   while (blocker)
+   {
+      if (blocker->ObjectID == ObjectID)
+      {
+         blocker = blocker->Next;
+         continue;
+      }
+
+      V2 ms;
+      V2SUB(&ms, S, &blocker->Position);
+      float ds2 = V2LEN2(&ms);
+      bool hit = false;
+
+      if (ds2 <= OBJMINDISTANCE2)
+      {
+         V2 me;
+         V2SUB(&me, E, &blocker->Position);
+         if (V2LEN2(&me) <= ds2)
+            hit = true;
+      }
+      else if (IntersectLineCircle(&blocker->Position, OBJMINDISTANCE, S, E))
+         hit = true;
+
+      if (hit)
+      {
+         out[0] = blocker->ObjectID;
+         out[1] = (int)blocker->Position.X;
+         out[2] = (int)blocker->Position.Y;
+         return 2;
+      }
+      blocker = blocker->Next;
+   }
+
+   return 0;
+}
