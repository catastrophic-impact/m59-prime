 /*
+ * C_ExplainMoveBSP: PRIME (patch 0073). ExplainMoveBSP(room, srow, scol, sfinerow, sfinecol, drow, dcol, dfinerow, dfinecol, objectid, *o1, *o2, *o3, *o4):
+ *    the verdict of CanMoveInRoomBSP with the reason. Returns 0 allowed, 1 a wall stops it (o1..o4 = wall P1.X, P1.Y, P2.X, P2.Y in roo units),
+ *    2 a body stops it (o1 = object id, o2/o3 = its position), 3 no room data / bad arguments. The four o variables are passed with the * operator.
+ */
+int C_ExplainMoveBSP(int object_id, local_var_type *local_vars,
+	int num_normal_parms, parm_node normal_parm_array[],
+	int num_name_parms, parm_node name_parm_array[])
+{
+	val_type ret_val, room_val, a[9], ov[4];
+	room_node *r;
+
+	ret_val.v.tag = TAG_INT;
+	ret_val.v.data = 3;
+
+	if (num_normal_parms != 14)
+		return ret_val.int_val;
+
+	room_val = RetrieveValue(object_id, local_vars, normal_parm_array[0].type, normal_parm_array[0].value);
+	for (int k = 0; k < 9; k++)
+		a[k] = RetrieveValue(object_id, local_vars, normal_parm_array[k + 1].type, normal_parm_array[k + 1].value);
+	for (int k = 0; k < 4; k++)
+		ov[k] = RetrieveValue(object_id, local_vars, normal_parm_array[10 + k].type, normal_parm_array[10 + k].value);
+
+	if (room_val.v.tag != TAG_ROOM_DATA)
+		return ret_val.int_val;
+	for (int k = 0; k < 8; k++)
+		if (a[k].v.tag != TAG_INT)
+			return ret_val.int_val;
+	if (a[8].v.tag != TAG_OBJECT)
+		return ret_val.int_val;
+	for (int k = 0; k < 4; k++)
+	{
+		int idx = (int)ov[k].v.data;
+		if (idx < 0 || idx >= MAX_LOCALS || local_vars->locals[idx].v.tag != TAG_INT)
+			return ret_val.int_val;
+	}
+
+	r = GetRoomDataByID(room_val.v.data);
+	if (r == NULL)
+		return ret_val.int_val;
+
+	V2 s;
+	s.X = GRIDCOORDTOROO(a[1].v.data, a[3].v.data);
+	s.Y = GRIDCOORDTOROO(a[0].v.data, a[2].v.data);
+
+	V2 e;
+	e.X = GRIDCOORDTOROO(a[5].v.data, a[7].v.data);
+	e.Y = GRIDCOORDTOROO(a[4].v.data, a[6].v.data);
+
+	int out[4];
+	ret_val.v.data = BSPExplainMove(&r->data, &s, &e, a[8].v.data, false, out);
+	for (int k = 0; k < 4; k++)
+		local_vars->locals[ov[k].v.data].v.data = out[k];
+
+	return ret_val.int_val;
+}
