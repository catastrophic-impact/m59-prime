+   GetSpellType(what = $)
+   {
+      // Prime: a lit Touch of Flame makes its blows fire
+      if piTouchUntil > GetTime()
+      {
+         return ATCK_SPELL_FIRE;
+      }
+
+      propagate;
+   }
+
+   FlameHands()
+   "Prime: an elementalist companion that has the spell lays Touch of Flame on its hands as a player does (the real mana cost); while it burns each blow raises its hands in the cast animation."
+   {
+      local oSpell, iPower, iCost;
+
+      if piKind <> COMPANION_ELEMENTALIST OR plProfile = $ OR poOwner = $
+      {
+         return;
+      }
+
+      iPower = Send(self,@AbilityPct,#bSkill=FALSE,#num=SID_TOUCH_OF_FLAME);
+      if iPower = 0
+      {
+         return;
+      }
+
+      if piTouchUntil <= GetTime()
+      {
+         oSpell = Send(SYS,@FindSpellByNum,#num=SID_TOUCH_OF_FLAME);
+         if oSpell = $
+         {
+            return;
+         }
+
+         iCost = Send(oSpell,@GetManaCost,#who=self,#iSpellPower=iPower);
+         if piMana < iCost
+         {
+            return;
+         }
+
+         piMana = piMana - iCost;
+         piTouchUntil = GetTime() + COMPANION_TOUCH_SECONDS;
+         Send(self,@NewMana);
+      }
+
+      Send(self,@MonsterCastAnimation,#iSpellNum=SID_TOUCH_OF_FLAME);
+
+      return;
+   }
+
