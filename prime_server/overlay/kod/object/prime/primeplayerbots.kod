   PBotTestPath(id = 0,rid = 0,row = 0,col = 0,trow = 0,tcol = 0)
   "PATH PROTOTYPE test driver (TEST ONLY): the bot is set down at a square of a room and told to walk to another by planning its own way (PlayerBot.TestPathTo), server wall check on."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $ OR Send(self,@NavRoom,#rid=rid) = $
      {
         return FALSE;
      }

      Send(oBot,@GainHealthNormal,#amount=99999,#precision=FALSE);
      Send(oBot,@SetStrict,#value=TRUE);
      Send(oBot,@ResetLocation);
      Send(self,@PBotPlace,#id=id,#rid=rid,#row=row,#col=col);
      Send(oBot,@TestPathTo,#iRow=trow,#iCol=tcol);

      return TRUE;
   }

   PBotTestBlocked(id = 0)
   "PATH PROTOTYPE test driver (TEST ONLY): the bot decides NOW what to do about the nearest creature, as if it blocked its way (PlayerBot.PathBlocked): TRUE and state 6 = it fights, TRUE and state 7 = it flees (rescue), FALSE = no creature within one and a half squares."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $
      {
         return FALSE;
      }

      return Send(oBot,@PathBlocked);
   }

   PBotTestPathState(id = 0)
   "PATH PROTOTYPE test driver: PlayerBot.PathState of the bot, or $."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $
      {
         return $;
      }

      return Send(oBot,@PathState);
   }

   PBotTestStrict(id = 0,value = 1)
   "Test driver: strict test mode of the bot on (1) or off (0): it keeps its activity, makes no quiet fixes (door placement, Rescue) and stays put when a walk fails."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $
      {
         return FALSE;
      }

      Send(oBot,@SetStrict,#value=value);

      return TRUE;
   }

   PBotTestAct(id = 0,act = 0)
   "Test driver: the bot begins activity act at once, with a long time to run (PBotStart chooses the rest)."
   {
      if Send(self,@PBotBodyOf,#id=id) = $
      {
         return FALSE;
      }

      Send(self,@PBotStart,#id=id,#act=act,#keep=FALSE);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + 7200);
      Debug("PBOT-TEST act start: bot",id,"act",act);

      return TRUE;
   }

   PBotTestState(id = 0)
   "Test driver: [ room, node, doing, journey room, stuck, in world (1/0), health, hunt kills, activity, hunt room, has target (1/0), monsters in its room, has a foe in reach (1/0), fightable foes alive ] of the bot, or $."
   {
      local oBot, lId, iMobs, iFoe;

      oBot = Send(self,@PBotBodyOf,#id=id);
      lId = Send(self,@PBotIdentity,#id=id);
      if oBot = $ OR lId = $
      {
         return $;
      }

      iMobs = 0;
      iFoe = 0;
      if Send(oBot,@GetOwner) <> $
      {
         iMobs = Send(Send(oBot,@GetOwner),@CountHoldingHowMany,#class=&Monster);
         iFoe = (Send(oBot,@HuntFoe) <> $);
      }

      return [Send(oBot,@GetNavRid),Send(oBot,@GetNavNode),Send(oBot,@GetDoing),Send(oBot,@GetJourneyRid),Send(oBot,@GetStuck),
              (Send(oBot,@GetOwner) <> $),Send(oBot,@GetHealth),Send(oBot,@GetHuntKills),Nth(lId,8),Nth(lId,10),(Send(oBot,@GetTarget) <> $),iMobs,iFoe,Send(oBot,@HuntFoeCount),Send(oBot,@GetFailed),Send(oBot,@GetRow),Send(oBot,@GetCol),Send(oBot,@GetGoalNode)];
   }

   PBotThink(id = 0)
   "Every few seconds for a bot in the game: when its activity is over it settles up and chooses the next."
   {
      local lId, oBody;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $ OR (Nth(lId,8) = PBA_NONE AND (GetTime() < Nth(lId,9) OR Send(self,@PBotBodyOf,#id=id) = $))
      {
         return;
      }

      // a bot in strict test mode keeps the activity it was given
      oBody = Send(self,@PBotBodyOf,#id=id);
      if oBody <> $ AND Send(oBody,@IsStrict)
      {
         return;
      }

      if Nth(lId,8) = PBA_SHOP
      {
         Send(self,@PBotShopPresence,#id=id);
      }

      if Nth(lId,8) = PBA_HUNT
      {
         Send(self,@PBotHuntPresence,#id=id);
      }

      if GetTime() < Nth(lId,9)
      {
         return;
      }

      Send(self,@PBotFinish,#id=id);
      Send(self,@PBotChoose,#id=id);

      return;
   }

   PBotMigrate()
   "Once after a start: characters made by an older version (fewer fields) are dropped, with their bodies."
   {
      local i, lKeep;

      lKeep = $;
      foreach i in plPBotIdentities
      {
         if Length(i) < 13
         {
            Send(self,@PBotLogout,#id=First(i));
         }
         else
         {
            lKeep = Cons(i,lKeep);
         }
      }

      plPBotIdentities = lKeep;

      return;
   }

   PBotNightOnly()
   "Hunt rooms whose monsters appear only at night (the game's own rule in the room's TryCreateMonster: before 5 or after 21 o'clock): Tos graveyard 70. More can be added here."
   {
      return [70];
   }

   PBotNightRoomClosed(rid = 0)
   "TRUE when this is a night-only hunt room and it is day: nothing spawns there, bots must neither choose it nor stay in it."
   {
      local iHour;

      if FindListElem(Send(self,@PBotNightOnly),rid) = 0
      {
         return FALSE;
      }

      iHour = Send(SYS,@GetHour);

      return NOT (iHour < 5 OR iHour > 21);
   }

   PBotNoHunt()
   "Hunt rooms bots must not choose on their own for now (the harness found them unhuntable; kept for research, see claude_dev_notes.txt SESSION 11): BAR_SEWER2 111, FOREST2 26, ORC_CAVE5 2504, MAZEFOYER 1601, MAZEFOYER2 1602, GOLEM_DUNGEON 2822."
   {
      return [111,26,2504,1601,1602,2822];
   }

   PBotSurvey()
   "Once after a start: survey hunting rooms for monster level, attack damage and timing, vision, and population for destination and route-risk estimates."
   {
      local oRoom, i, j, lLevels, lList, iSum, iPct, iLvl, lRooms, iTop, oTop,
         iDpsSum, iDamage, iAttackTime, iVision, iVisionMax, iAttackers,
         iDps, iSpellPower, iSpellDamage, iSpellDps, lSpellBook, oSpell, lDamageRange;

      // the level of every kind of monster, from the templates
      lLevels = $;
      foreach i in Send(SYS,@GetMonsterTemplates)
      {
         // ground worms (burrowed: only a hammer or mace hurts them) and kriipa (on the roof) cannot be fought by a bot: rooms of only them are no hunting rooms
         if IsClass(i,&Monster) AND NOT IsClass(i,&GroundWorm) AND NOT IsClass(i,&Kriipa)
         {
            iDamage = Send(i,@GetDamage);
            iAttackTime = Send(i,@GetAttackTime);
            if iAttackTime = $ OR iAttackTime < 1
            {
               iAttackTime = 3000;
            }
            iVision = Send(i,@GetVisionDistance);
            iDps = iDamage * 1000 / iAttackTime;
            // A caster's spell is often the real danger (for example, a
            // lightning tree). Use its strongest damaging spell as a
            // conservative per-attack estimate as well as its weapon damage.
            lSpellBook = Send(i,@GetSpellBook);
            foreach j in lSpellBook
            {
               oSpell = Send(SYS,@FindSpellByNum,#num=First(j));
               if oSpell <> $ AND IsClass(oSpell,&AttackSpell)
               {
                  lDamageRange = Send(oSpell,@GetDamageRange);
                  iSpellDamage = (First(lDamageRange) + Nth(lDamageRange,2)) / 2;
                  iSpellPower = Send(i,@GetBaseSpellPower);
                  iSpellDamage = iSpellDamage * (50 + iSpellPower / 2) / 100;
                  iSpellDps = iSpellDamage * 1000 / iAttackTime;
                  if iSpellDps > iDps
                  {
                     iDps = iSpellDps;
                  }
               }
            }
            lLevels = Cons([GetClass(i),Send(i,@GetLevel),i,iDps,iVision],lLevels);
         }
      }

      lRooms = $;
      foreach oRoom in Send(SYS,@GetRooms)
      {
         if IsClass(oRoom,&MonsterRoom) AND NOT IsClass(oRoom,&SurvivalRoom)
         {
            lList = Send(oRoom,@GetMonsterList);
            iSum = 0;
            iPct = 0;
            iDpsSum = 0;
            iVisionMax = 0;
            iTop = 0;
            oTop = $;
            foreach j in lList
            {
               iLvl = 0;
               foreach i in lLevels
               {
                  if First(i) = First(j)
                  {
                     iLvl = Nth(i,2);
                     iDpsSum += Nth(i,4) * Nth(j,2);
                     if Nth(i,5) > iVisionMax
                     {
                        iVisionMax = Nth(i,5);
                     }
                     if Nth(j,2) > iTop
                     {
                        iTop = Nth(j,2);
                        oTop = Nth(i,3);
                     }
                  }
               }

               if iLvl > 0
               {
                  iSum += iLvl * Nth(j,2);
                  iPct += Nth(j,2);
               }
            }

            if iPct > 0 AND Length(lRooms) < 380 AND Send(self,@PBotCanRoam,#rid=Send(oRoom,@GetRoomNum))
               AND FindListElem(Send(self,@PBotNoHunt),Send(oRoom,@GetRoomNum)) = 0
            {
               // Five is MonsterRoom's standard initial spawn maximum. Some
               // room classes override it; first-pass risk remains an estimate.
               iAttackers = 5;
               lRooms = Cons([Send(oRoom,@GetRoomNum),iSum / iPct,Length(lList),oTop,iDpsSum / iPct,iVisionMax,iAttackers],lRooms);
            }
         }
      }

      plPBotRooms = lRooms;

      return;
   }

   PBotRestartReset()
   "A server restart (or by hand: send object <prime> PBotRestartReset): every bot is taken home like a Rescue (an inn of its home town; a dead one is revived, a shop visit or hunt trip ended, stale walks and timers dropped) and chooses a new activity after 20-60 s. A simple, honest reset."
   {
      local i, oBot, iCount;

      iCount = 0;
      foreach i in plPBotBodies
      {
         oBot = Nth(i,2);
         if oBot <> $
         {
            Send(oBot,@RescueRestart);
            ++iCount;
         }
      }

      Debug("PBOT-RESTART: every bot taken home and given a new activity:",iCount);

      return;
   }

   PBotsTick()
   "Every second (BotsTick): every few seconds the number of bots in the game is brought to the rule piPlayerBotCount, or to none when the rule is off."
   {
      local iWant, iHave, i, lId, lFree, lRenew, oRobe;

      ++piPBotTicks;
      if piPBotTicks < 5
      {
         return;
      }

      piPBotTicks = 0;
      if piPBotSeen > 0 AND GetTime() - piPBotSeen > 30
      {
         Send(self,@PBotRestartReset);
      }

      piPBotSeen = GetTime();
      ++piPBotUp;

      // the rule piBotNameType changed (or this is the first start): every bot in the game gets a name of the kind asked for, by a fresh login (its who entry is told again)
      if piBotNamesApplied <> piBotNameType
      {
         piBotNamesApplied = piBotNameType;
         lRenew = $;
         foreach i in plPBotBodies
         {
            lRenew = Cons(First(i),lRenew);
         }

         foreach i in lRenew
         {
            Send(self,@PBotLogout,#id=i);
            Send(self,@PBotLogin,#id=i);
         }
      }

      if piPBotUp = 1
      {
         Send(self,@PBotMigrate);
         // the survey is made again after every start (it holds monster templates)
         plPBotRooms = $;
      }

      if piPBotUp = 3
      {
         Send(self,@PBotRebalance);
      }

      // the disciple robes of the bots in the world: their colour follows the class level (RobeLevel); worked out again at the first tick after a start and then every five minutes
      // (a robe made before this rule, or by an older tier, is not left behind)
      if GetTime() >= piPBotRobeCheck
      {
         piPBotRobeCheck = GetTime() + 300;
         foreach i in plPBotBodies
         {
            oRobe = Send(Nth(i,2),@FindUsing,#class=&DiscipleRobe);
            if oRobe <> $
            {
               Send(oRobe,@ResetColors);
            }
         }
      }

      if (piPBotUp = 12 AND plPBotRooms = $) OR (plPBotRooms <> $ AND Length(First(plPBotRooms)) < 7)
      {
         Send(self,@PBotSurvey);
      }

      foreach i in plPBotBodies
      {
         Send(self,@PBotThink,#id=First(i));
      }

      Send(self,@PBotChatterTick);

      iWant = 0;
      if piTownLife >= 1
      {
         iWant = piPlayerBotCount;
      }

      iHave = Length(plPBotBodies);
      if iHave > iWant
      {
         Send(self,@PBotLogout,#id=First(First(plPBotBodies)));

         return;
      }

      if iHave < iWant
      {
         // one of the characters that are not in the game, else a new one
         lFree = $;
         foreach i in plPBotIdentities
         {
            if Send(self,@PBotBodyOf,#id=First(i)) = $
            {
               lFree = Cons(First(i),lFree);
            }
         }

         if lFree <> $ AND (Random(1,100) <= 70 OR Length(plPBotIdentities) >= 150)
         {
            Send(self,@PBotLogin,#id=Nth(lFree,Random(1,Length(lFree))));

            return;
         }

         lId = Send(self,@PBotNewIdentity);
         if lId <> $
         {
            Send(self,@PBotLogin,#id=First(lId));
         }
      }

      return;
   }

   PBotStatus(id = 0,oBot = $)
   "[ frame resource, arguments ... ] for the info window of a bot (the frame's first three %s are the description parts), or $ when the rule piBotShowDoing is off."
   {
      local lId, iAct, i, oRoom, oTop, lRegion;

      if NOT piBotShowDoing
      {
         return $;
      }

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return $;
      }

      iAct = Nth(lId,8);
      if iAct = PBA_HUNT
      {
         oRoom = Send(SYS,@FindRoomByNum,#num=Nth(lId,10));
         oTop = $;
         foreach i in plPBotRooms
         {
            if First(i) = Nth(lId,10)
            {
               oTop = Nth(i,4);
            }
         }

         if oRoom <> $ AND oTop <> $
         {
            return [pbr_hunt,Send(oTop,@GetName),Send(oRoom,@GetName)];
         }
      }

      if iAct = PBA_SHOP
      {
         oRoom = Send(SYS,@FindRoomByNum,#num=Nth(lId,12));
         if oRoom <> $
         {
            return [pbr_shop,Send(oRoom,@GetName)];
         }
      }

      lRegion = Send(self,@PBotRegion,#home=Nth(lId,7));
      oRoom = Send(SYS,@FindRoomByNum,#num=First(Nth(lRegion,2)));
      if iAct = PBA_DEAD AND oRoom <> $
      {
         return [pbr_dead,Send(oRoom,@GetName)];
      }

      if oBot <> $
      {
         return Send(oBot,@StatusList);
      }

      return $;
   }

   TownCrowdOff()
   "Is the townsfolk crowd of the client switched off (rule piTownLife = 1, playerbots instead)?"
   {
      return piTownLife = 1;
   }

   PBotsInWho(lUsers = $)
   "Hook in User.ToCliPlayers: the bots in the game are in the list the client gets, so they are in who and can be told."
   {
      local i;

      foreach i in plPBotBodies
      {
         lUsers = Cons(Nth(i,2),lUsers);
      }

      return lUsers;
   }

end
