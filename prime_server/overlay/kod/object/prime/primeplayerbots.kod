   pbg_m107 = "Hawk"
   pbg_m108 = "Jolt"
   pbg_m109 = "Knox"
   pbg_m110 = "Lynx"
   pbg_m111 = "Mace"
   pbg_m112 = "Nuke"
   pbg_m113 = "Onyx"
   pbg_m114 = "Prowl"
   pbg_m115 = "Rex"
   pbg_m116 = "Slate"
   pbg_m117 = "Tank"
   pbg_m118 = "Vex"
   pbg_m119 = "Warg"
   pbg_m120 = "Zap"

properties:

   // [ id, name resource, gender, kind (4 warrior .. 7 elementalist), base health, ability percent, home town room number, activity (PBA_*), GetTime() when it ends,
   //   room it hunts in, shillings (picked up from real kills), GetTime() when a dead one is back, reagents carried (a count, from real kills) ]
   plPBotIdentities = $
   // [ id, body ] of the bots that are logged in
   plPBotBodies = $
   piPBotNextId = 1
   piPBotTicks = 0
   // [ room number, average level of its monsters, how many ] of the rooms with monsters worth hunting, made once after a start (PBotSurvey)
   plPBotRooms = $
   piPBotUp = 0
   // the piBotNameType the bots' names were last made for (-1 = none yet): when the rule differs, PBotsTick renames them all
   piBotNamesApplied = -1
   // when the bots' disciple robes are worked out again (PBotsTick)
   piPBotRobeCheck = 0
   // townsfolk lines: [ room, when it may speak again ] per room, and [ player, when a bot may greet them again ] per player (the lists keep only what is still waiting)
   plPBotRoomSay = $
   plPBotGreeted = $
   // [ when, bot id, line ] of the broadcast lines waiting their turn (a chat thread, or an answer to a player's greeting), [ number ] of the last chats told (so they do not repeat soon),
   // when the next chat may start, [ who, when they may broadcast again ] and [ player, when a bot may answer them again ]
   plPBotCast = $
   plPBotChatRecent = $
   piPBotChatNext = 0
   plPBroadcastLast = $
   plPBotReplied = $
   // GetTime() of the last PBotsTick: a gap of more than 30 s means the server was down (a restart): every bot is then taken home like a Rescue and chooses a new activity (PBotRestartReset)
   piPBotSeen = 0
   piPBotNoRisk = 0
   // [ room number, [ its doors, nav squares, its nodes ] or $ ] for the route search, made once per bake (PBotDoorsOf)
   plPBotDoorCache = $
   piPBotNavStamp = 0
   // Bot trace (debug): the bot id whose walk is written to the debug log as PBOT-TRACE lines (-1 = every bot, 0 = off). It switches itself off after piPBotTraceMax lines
   // or piPBotTraceMins minutes, whichever comes first. scripts/bot_trace.sh reads and removes the lines.
   piPBotTrace = 0
   piPBotTraceLines = 0
   piPBotTraceEnd = 0
   piPBotTraceMax = 3000
   piPBotTraceMins = 15

messages:

   PBotMaleNames(part = 1)
   "150 men's names in four parts of up to 38 (a list literal may hold only 40); only men have them."
   {
      if part = 1
      {
         return [
            pbn_m1, pbn_m2, pbn_m3, pbn_m4, pbn_m5, pbn_m6, pbn_m7, pbn_m8, pbn_m9, pbn_m10,
            pbn_m11, pbn_m12, pbn_m13, pbn_m14, pbn_m15, pbn_m16, pbn_m17, pbn_m18, pbn_m19, pbn_m20,
            pbn_m21, pbn_m22, pbn_m23, pbn_m24, pbn_m25, pbn_m26, pbn_m27, pbn_m28, pbn_m29, pbn_m30,
            pbn_m31, pbn_m32, pbn_m33, pbn_m34, pbn_m35, pbn_m36, pbn_m37, pbn_m38
         ];
      }

      else if part = 2
      {
         return [
            pbn_m39, pbn_m40, pbn_m41, pbn_m42, pbn_m43, pbn_m44, pbn_m45, pbn_m46, pbn_m47, pbn_m48,
            pbn_m49, pbn_m50, pbn_m51, pbn_m52, pbn_m53, pbn_m54, pbn_m55, pbn_m56, pbn_m57, pbn_m58,
            pbn_m59, pbn_m60, pbn_m61, pbn_m62, pbn_m63, pbn_m64, pbn_m65, pbn_m66, pbn_m67, pbn_m68,
            pbn_m69, pbn_m70, pbn_m71, pbn_m72, pbn_m73, pbn_m74, pbn_m75, pbn_m76
         ];
      }

      else if part = 3
      {
         return [
            pbn_m77, pbn_m78, pbn_m79, pbn_m80, pbn_m81, pbn_m82, pbn_m83, pbn_m84, pbn_m85, pbn_m86,
            pbn_m87, pbn_m88, pbn_m89, pbn_m90, pbn_m91, pbn_m92, pbn_m93, pbn_m94, pbn_m95, pbn_m96,
            pbn_m97, pbn_m98, pbn_m99, pbn_m100, pbn_m101, pbn_m102, pbn_m103, pbn_m104, pbn_m105, pbn_m106,
            pbn_m107, pbn_m108, pbn_m109, pbn_m110, pbn_m111, pbn_m112, pbn_m113, pbn_m114
         ];
      }

      else if part = 4
      {
         return [
            pbn_m115, pbn_m116, pbn_m117, pbn_m118, pbn_m119, pbn_m120, pbn_m121, pbn_m122, pbn_m123, pbn_m124,
            pbn_m125, pbn_m126, pbn_m127, pbn_m128, pbn_m129, pbn_m130, pbn_m131, pbn_m132, pbn_m133, pbn_m134,
            pbn_m135, pbn_m136, pbn_m137, pbn_m138, pbn_m139, pbn_m140, pbn_m141, pbn_m142, pbn_m143, pbn_m144,
            pbn_m145, pbn_m146, pbn_m147, pbn_m148, pbn_m149, pbn_m150
         ];
      }

      return $;
   }

   PBotFemaleNames(part = 1)
   "150 women's names in four parts of up to 38 (a list literal may hold only 40); only women have them."
   {
      if part = 1
      {
         return [
            pbn_f1, pbn_f2, pbn_f3, pbn_f4, pbn_f5, pbn_f6, pbn_f7, pbn_f8, pbn_f9, pbn_f10,
            pbn_f11, pbn_f12, pbn_f13, pbn_f14, pbn_f15, pbn_f16, pbn_f17, pbn_f18, pbn_f19, pbn_f20,
            pbn_f21, pbn_f22, pbn_f23, pbn_f24, pbn_f25, pbn_f26, pbn_f27, pbn_f28, pbn_f29, pbn_f30,
            pbn_f31, pbn_f32, pbn_f33, pbn_f34, pbn_f35, pbn_f36, pbn_f37, pbn_f38
         ];
      }

      else if part = 2
      {
         return [
            pbn_f39, pbn_f40, pbn_f41, pbn_f42, pbn_f43, pbn_f44, pbn_f45, pbn_f46, pbn_f47, pbn_f48,
            pbn_f49, pbn_f50, pbn_f51, pbn_f52, pbn_f53, pbn_f54, pbn_f55, pbn_f56, pbn_f57, pbn_f58,
            pbn_f59, pbn_f60, pbn_f61, pbn_f62, pbn_f63, pbn_f64, pbn_f65, pbn_f66, pbn_f67, pbn_f68,
            pbn_f69, pbn_f70, pbn_f71, pbn_f72, pbn_f73, pbn_f74, pbn_f75, pbn_f76
         ];
      }

      else if part = 3
      {
         return [
            pbn_f77, pbn_f78, pbn_f79, pbn_f80, pbn_f81, pbn_f82, pbn_f83, pbn_f84, pbn_f85, pbn_f86,
            pbn_f87, pbn_f88, pbn_f89, pbn_f90, pbn_f91, pbn_f92, pbn_f93, pbn_f94, pbn_f95, pbn_f96,
            pbn_f97, pbn_f98, pbn_f99, pbn_f100, pbn_f101, pbn_f102, pbn_f103, pbn_f104, pbn_f105, pbn_f106,
            pbn_f107, pbn_f108, pbn_f109, pbn_f110, pbn_f111, pbn_f112, pbn_f113, pbn_f114
         ];
      }

      else if part = 4
      {
         return [
            pbn_f115, pbn_f116, pbn_f117, pbn_f118, pbn_f119, pbn_f120, pbn_f121, pbn_f122, pbn_f123, pbn_f124,
            pbn_f125, pbn_f126, pbn_f127, pbn_f128, pbn_f129, pbn_f130, pbn_f131, pbn_f132, pbn_f133, pbn_f134,
            pbn_f135, pbn_f136, pbn_f137, pbn_f138, pbn_f139, pbn_f140, pbn_f141, pbn_f142, pbn_f143, pbn_f144,
            pbn_f145, pbn_f146, pbn_f147, pbn_f148, pbn_f149, pbn_f150
         ];
      }

      return $;
   }

   PBotTowns()
   "The room numbers of the towns a bot may live in (its home): Tos, Barloque, Cor Noth, Marion, Raza, Jasper, Ko'catan, Bergensdorf, Jixa. Each is a region of PrimeNavData (NavTowns)."
   {
      return [ 50, 102, 150, 200, 300, 350, 2000, 2800, 2903 ];
   }

   PBotRegion(home = 0)
   "[ home, [ street rooms ], [ inns ] ] of a home town (the first town if it is not known)."
   {
      local i;

      foreach i in Send(self,@NavTowns)
      {
         if First(i) = home
         {
            return i;
         }
      }

      return First(Send(self,@NavTowns));
   }

   PBotShopRoom(home = 0)
   "A reachable merchant room in this bot's home town, or $ when the baked street links contain none."
   {
      local lRegion, lStreets, lNav, lDoor, oRoom, iCount, i, oMerchant, lShops;

      lRegion = Send(self,@PBotRegion,#home=home);
      lStreets = Nth(lRegion,2);
      lShops = $;
      foreach i in lStreets
      {
         lNav = Send(self,@NavRoom,#rid=i);
         if lNav = $
         {
            continue;
         }

         foreach lDoor in Nth(lNav,3)
         {
            if Nth(lDoor,4) = 1 AND NOT Send(self,@NavIsInn,#rid=Nth(lDoor,6))
            {
               oRoom = Send(SYS,@FindRoomByNum,#num=Nth(lDoor,6));
               if oRoom <> $
               {
                  iCount = Send(oRoom,@CountHoldingHowMany,#class=&Monster);
                  i = 0;
                  while i < iCount
                  {
                     ++i;
                     oMerchant = Send(oRoom,@FindHoldingActive,#class=&Monster,#sequence=i);
                     if oMerchant <> $ AND (Send(oMerchant,@GetAttributes) & MOB_SELLER)
                     {
                        lShops = Cons(Nth(lDoor,6),lShops);
                        break;
                     }
                  }
               }
            }
         }
      }

      if lShops = $
      {
         return $;
      }

      return Nth(lShops,Random(1,Length(lShops)));
   }

   NavIsInn(rid = 0)
   "Is this room an inn of the graphs?"
   {
      local i, j;

      foreach i in Send(self,@NavTowns)
      {
         foreach j in Nth(i,3)
         {
            if j = rid
            {
               return TRUE;
            }
         }
      }

      return FALSE;
   }

   PBotIsSafeRoom(rid = 0)
   "Is this a street or an inn of one of the towns, the only rooms where a bot passes the time, talks or chats (a hunting ground is not)?"
   {
      local i, j;

      foreach i in Send(self,@NavTowns)
      {
         foreach j in Nth(i,2)
         {
            if j = rid
            {
               return TRUE;
            }
         }

         foreach j in Nth(i,3)
         {
            if j = rid
            {
               return TRUE;
            }
         }
      }

      return FALSE;
   }

   NavNodePos(rid = 0,node = 0)
   "[ row, col ] of a node of a room's graph, or $."
   {
      local lInfo;

      lInfo = Send(self,@PBotDoorsOf,#rid=rid);
      if lInfo = $ OR node < 1 OR node > Length(Nth(lInfo,3))
      {
         return $;
      }

      return Nth(Nth(lInfo,3),node);
   }

   NavNearest(rid = 0,row = 0,col = 0,oWho = $)
   "The node of a room's graph nearest a square (0 when the room has no graph). oWho is kept for the callers' sake and ignored: where a bot walks is the planner's business, the node is only a name for the part of the room it is in."
   {
      local lInfo, lNodes, p, iIdx, iBest, iBestD, iD;

      lInfo = Send(self,@PBotDoorsOf,#rid=rid);
      if lInfo = $
      {
         return 0;
      }

      lNodes = Nth(lInfo,3);
      iBest = 0;
      iBestD = 999999;
      iIdx = 0;
      foreach p in lNodes
      {
         ++iIdx;
         iD = Abs(row - First(p)) * Abs(row - First(p)) + Abs(col - Nth(p,2)) * Abs(col - Nth(p,2));
         if iD < iBestD
         {
            iBestD = iD;
            iBest = iIdx;
         }
      }

      return iBest;
   }

   PBotCap(kind = 0)
   "The top of the scale for a class: a bot's health is its level (20 to this)."
   {
      return 100 + Send(self,@CompStamina,#kind=kind);
   }

   PBotBand(health = 20,kind = 0)
   "Which fifth of its class's scale (0 lowest, 4 top) a level is in."
   {
      return Bound((health - 20) * 5 / Bound(Send(self,@PBotCap,#kind=kind) - 20,1,$),0,4);
   }

   PBotBandShare(band = 0)
   "The share, in percent, of all playerbots that should be in this band: many beginners, few veterans."
   {
      return Nth([35,25,18,12,10],band + 1);
   }

   PBotBandCount(band = 0)
   "How many of the characters are in this band."
   {
      local i, iCount;

      iCount = 0;
      foreach i in plPBotIdentities
      {
         if Send(self,@PBotBand,#health=Nth(i,5),#kind=Nth(i,4)) = band
         {
            ++iCount;
         }
      }

      return iCount;
   }

   PBotStartLevel(kind = 0)
   "The level a new character starts at: a band drawn from the shares, with a pull towards the levels of the players online, then a level inside it."
   {
      local i, iRoll, iBand, iCap, iLo, iHi, lPlayers, oUser;

      iCap = Send(self,@PBotCap,#kind=kind);
      iBand = 0;
      iRoll = Random(1,100);
      while iBand < 4 AND iRoll > Send(self,@PBotBandShare,#band=iBand)
      {
         iRoll = iRoll - Send(self,@PBotBandShare,#band=iBand);
         ++iBand;
      }

      if Random(1,100) <= 40
      {
         // near a player who is online (a group to join, rivals to meet)
         lPlayers = $;
         foreach i in Send(SYS,@GetUsersLoggedOn)
         {
            oUser = i;
            if IsClass(oUser,&Player) AND NOT IsClass(oUser,&DM)
            {
               lPlayers = Cons(oUser,lPlayers);
            }
         }

         if lPlayers <> $
         {
            oUser = Nth(lPlayers,Random(1,Length(lPlayers)));
            iBand = Bound(Send(self,@PBotBand,#health=Send(oUser,@GetBaseMaxHealth),#kind=kind) + Random(-1,1),0,4);
         }
      }

      return Send(self,@PBotLevelIn,#band=iBand,#kind=kind);
   }

   PBotLevelIn(band = 0,kind = 0)
   "A level inside a band of a class's scale."
   {
      local iCap, iLo, iHi;

      iCap = Send(self,@PBotCap,#kind=kind);
      iLo = 20 + band * (iCap - 20) / 5;
      iHi = 20 + (band + 1) * (iCap - 20) / 5;
      if band = 4
      {
         iHi = iCap;
      }

      return Bound(Random(iLo,Bound(iHi,iLo,$)),20,iCap);
   }

   PBotRebalance()
   "Once after a start: characters made before the level spread existed (all beginners) are given levels so that every band has its share."
   {
      local i, b, iBest, iDeficit, iTotal, iBandNo;

      iTotal = Length(plPBotIdentities);
      foreach i in plPBotIdentities
      {
         b = Send(self,@PBotBand,#health=Nth(i,5),#kind=Nth(i,4));
         if Send(self,@PBotBandCount,#band=b) * 100 > iTotal * Send(self,@PBotBandShare,#band=b)
         {
            iBest = -1;
            iDeficit = 0;
            iBandNo = 0;
            while iBandNo < 5
            {
               if iTotal * Send(self,@PBotBandShare,#band=iBandNo) - Send(self,@PBotBandCount,#band=iBandNo) * 100 > iDeficit
               {
                  iDeficit = iTotal * Send(self,@PBotBandShare,#band=iBandNo) - Send(self,@PBotBandCount,#band=iBandNo) * 100;
                  iBest = iBandNo;
               }

               ++iBandNo;
            }

            if iBest >= 0
            {
               Send(self,@PBotSet,#id=First(i),#pos=5,#value=Send(self,@PBotLevelIn,#band=iBest,#kind=Nth(i,4)));
            }
         }
      }

      return;
   }

   PBotMayRise(id = 0)
   "May this character rise a level? Not into a band that is already full: the world keeps its beginners and its few veterans."
   {
      local lId, iBand, iNew;

      lId = Send(self,@PBotIdentity,#id=id);
      iBand = Send(self,@PBotBand,#health=Nth(lId,5),#kind=Nth(lId,4));
      iNew = Send(self,@PBotBand,#health=Nth(lId,5) + 1,#kind=Nth(lId,4));
      if iNew = iBand
      {
         return TRUE;
      }

      return Send(self,@PBotBandCount,#band=iNew) * 100 < Length(plPBotIdentities) * Send(self,@PBotBandShare,#band=iNew);
   }

   PBotRetire(id = 0)
   "A veteran leaves the world for good (it has gone home, it is said); a beginner with a new name takes its place."
   {
      local i, lKeep;

      Send(self,@PBotLogout,#id=id);
      lKeep = $;
      foreach i in plPBotIdentities
      {
         if First(i) <> id
         {
            lKeep = Cons(i,lKeep);
         }
      }

      plPBotIdentities = lKeep;
      Send(self,@PBotNewIdentity);

      return;
   }

   PBotNodeLoad(rid = 0,node = 0,oExcept = $)
   "How many other bodies of the registry stand at, or are walking to, this node of a room."
   {
      local i, oBot, iCount;

      iCount = 0;
      foreach i in plPBotBodies
      {
         oBot = Nth(i,2);
         if oBot <> oExcept AND Send(oBot,@GetOwner) <> $ AND Send(oBot,@GetNavRid) = rid
            AND Send(oBot,@GetParkNode) = node
         {
            ++iCount;
         }
      }

      return iCount;
   }

   PBotRouteRoomDamage(rid = 0,iSquares = 0)
   "Conservative first-pass damage estimate for sprinting across a room: expected monster DPS, initial population cap and time in their vision."
   {
      local i, iDps, iVision, iAttackers, iExposure;

      if piPBotNoRisk
      {
         // test mode (scripts/bot_scenarios.py): no map is dangerous, so every route can be walked
         return 0;
      }

      foreach i in plPBotRooms
      {
         if First(i) = rid
         {
            if Length(i) < 7
            {
               return 0;
            }

            iDps = Nth(i,5);
            iVision = Nth(i,6);
            iAttackers = Nth(i,7);
            // Sprint travel is estimated at 0.5 seconds per nav square, with
            // extra exposure for the room's longest reported vision distance.
            iExposure = (iSquares + 2 * iVision) * 500;

            return iDps * iAttackers * iExposure / 1000;
         }
      }

      return 0;
   }

   PBotTraceWanted(id = 0)
   "Is the bot trace on for this bot (no line is counted)? Cheap enough to ask at every step."
   {
      return piPBotTrace <> 0 AND (piPBotTrace < 0 OR piPBotTrace = id) AND (piPBotTraceEnd = 0 OR GetTime() <= piPBotTraceEnd);
   }

   PBotTraceOn(id = 0)
   "Is the bot trace on for this bot? It counts the lines and switches itself off at its limits (3000 lines or 15 minutes, set when it was turned on)."
   {
      if piPBotTrace = 0
      {
         return FALSE;
      }

      if piPBotTraceEnd = 0
      {
         piPBotTraceEnd = GetTime() + piPBotTraceMins * 60;
         piPBotTraceLines = 0;
      }

      if GetTime() > piPBotTraceEnd OR piPBotTraceLines >= piPBotTraceMax
      {
         Debug("PBOT-TRACE off: limit reached after",piPBotTraceLines,"lines");
         piPBotTrace = 0;
         piPBotTraceEnd = 0;

         return FALSE;
      }

      if piPBotTrace > 0 AND piPBotTrace <> id
      {
         return FALSE;
      }

      ++piPBotTraceLines;

      return TRUE;
   }

   PBotHuntFailLimit()
   "The rule piBotHuntFailLimit: failed attempts in a row to find or reach a foe after which a hunter gives its hunt up."
   {
      return piBotHuntFailLimit;
   }

   PBotHuntMargin()
   "The rule piBotHuntMargin (percent): how much faster than it would die a hunter must be able to kill a foe it picks."
   {
      return piBotHuntMargin;
   }

   PBotFightMargin()
   "The rule piBotFightMargin (percent): the same test for a creature that blocks a bot's way."
   {
      return piBotFightMargin;
   }

   PBotFleePct()
   "The rule piBotFleePct: below this percent of its health a bot that fights a blocker flees."
   {
      return piBotFleePct;
   }

   PBotHuntPauseSecs()
   "The rule piBotHuntPauseSecs scaled by piBotTimeScale: seconds a hunter stands after a kill and its loot."
   {
      return Send(self,@PBotScale,#seconds=piBotHuntPauseSecs);
   }

   PBotSayOn()
   "The rule pbBotSocialSay: bots say townsfolk lines now and then."
   {
      return pbBotSocialSay;
   }

   PBotGreetOn()
   "The rule pbBotSocialGreet: bots greet a player who is near."
   {
      return pbBotSocialGreet;
   }

   PBotReplyOn()
   "The rule pbBotSocialReply: bots answer a player's hello or goodbye."
   {
      return pbBotSocialReply;
   }

   PBroadcastAllowed(oWho = $)
   "The broadcast wait (rule piBroadcastCooldownSecs): TRUE when this player (or bot) may broadcast now, and it starts their wait; a DM may always. A player who must wait is told so."
   {
      local i, lKeep, bOk;

      if oWho = $ OR IsClass(oWho,&DM) OR piBroadcastCooldownSecs <= 0
      {
         return TRUE;
      }

      bOk = TRUE;
      lKeep = $;
      foreach i in plPBroadcastLast
      {
         if GetTime() < Nth(i,2)
         {
            lKeep = Cons(i,lKeep);
            if First(i) = oWho
            {
               bOk = FALSE;
            }
         }
      }

      if bOk
      {
         lKeep = Cons([oWho,GetTime() + piBroadcastCooldownSecs],lKeep);
      }
      else if IsClass(oWho,&User)
      {
         Send(oWho,@MsgSendUser,#message_rsc=pbc_cooldown);
      }

      plPBroadcastLast = lKeep;

      return bOk;
   }

   PBotSpeechKind(string = $)
   "What a player said, for the bots to answer: 1 a hello, 2 a goodbye, 0 anything else. Short greetings (hi, hey) count only as the whole message."
   {
      if string = $
      {
         return 0;
      }

      if StringEqual(string,pbk_hi) OR StringEqual(string,pbk_hey) OR StringEqual(string,pbk_yo) OR StringEqual(string,pbk_hiya)
         OR StringEqual(string,pbk_hibang) OR StringEqual(string,pbk_heybang) OR StringEqual(string,pbk_hiall)
         OR StringEqual(string,pbk_hieveryone) OR StringEqual(string,pbk_heyall) OR StringEqual(string,pbk_heyeveryone)
         OR StringContain(string,pbk_hello) OR StringContain(string,pbk_hail) OR StringContain(string,pbk_greetings)
         OR StringContain(string,pbk_howdy) OR StringContain(string,pbk_goodday) OR StringContain(string,pbk_goodmorning)
         OR StringContain(string,pbk_goodevening)
      {
         return 1;
      }

      if StringContain(string,pbk_bye) OR StringContain(string,pbk_farewell) OR StringContain(string,pbk_seeyou)
         OR StringContain(string,pbk_cya) OR StringContain(string,pbk_goodnight)
      {
         return 2;
      }

      return 0;
   }

   PBotReplyAllowed(oUser = $,iSecs = 20)
   "A player's line is answered by one bot only, and then by none for iSecs seconds: TRUE when this player may be answered now (the wait starts)."
   {
      local i, lKeep, bOk;

      bOk = TRUE;
      lKeep = $;
      foreach i in plPBotReplied
      {
         if GetTime() < Nth(i,2)
         {
            lKeep = Cons(i,lKeep);
            if First(i) = oUser
            {
               bOk = FALSE;
            }
         }
      }

      if bOk
      {
         lKeep = Cons([oUser,GetTime() + iSecs],lKeep);
      }

      plPBotReplied = lKeep;

      return bOk;
   }

   PBotHeardBroadcast(oUser = $,string = $)
   "Called after a player's broadcast went out: a greeting in it (hello everyone) is answered by one bot with a greeting of its own, a few seconds later (rule pbBotSocialReply, once per player per 5 minutes)."
   {
      local lBot, lPool;

      if NOT pbBotSocialReply OR plPBotBodies = $ OR Send(self,@PBotSpeechKind,#string=string) <> 1
         OR NOT Send(self,@PBotReplyAllowed,#oUser=oUser,#iSecs=300)
      {
         return;
      }

      lBot = Nth(plPBotBodies,Random(1,Length(plPBotBodies)));
      lPool = Send(Nth(lBot,2),@SayPool,#iKind=5);
      plPBotCast = Cons([GetTime() + Random(3,8),First(lBot),Nth(lPool,Random(1,Length(lPool)))],plPBotCast);

      return;
   }

   PBotChatterTick()
   "Every few seconds: the broadcast lines whose time has come are said by their bots (one per tick; a bot that is gone, or must still wait, loses its line); and, rule pbBotSocialBroadcast, a new chat (two to four lines between two bots, or a single call) starts every 1 to 5 minutes while a real player is online."
   {
      local i, lDue, oBody, iNum, lThread, lA, lB, iAt, iLine, iTry;

      // one line per tick, the earliest that is due (so a chat keeps its order and the lines come at least a tick apart)
      lDue = $;
      foreach i in plPBotCast
      {
         if GetTime() >= First(i) AND (lDue = $ OR First(i) <= First(lDue))
         {
            lDue = i;
         }
      }

      if lDue <> $
      {
         plPBotCast = DelListElem(plPBotCast,lDue);
         oBody = Send(self,@PBotBodyOf,#id=Nth(lDue,2));
         if oBody <> $ AND Send(self,@PBroadcastAllowed,#oWho=oBody)
         {
            Send(SYS,@SystemBroadcast,#what=oBody,#type=SAY_EVERYONE,#string=SetString($,Nth(lDue,3)));
         }
      }

      if NOT pbBotSocialBroadcast OR plPBotCast <> $ OR Length(plPBotBodies) < 2
      {
         return;
      }

      // nobody to hear it: the next chat waits half a minute to a minute and a half after somebody is there
      if Send(SYS,@GetUsersLoggedOn) = $
      {
         piPBotChatNext = GetTime() + Send(self,@PBotScale,#seconds=Random(30,90));

         return;
      }

      if GetTime() < piPBotChatNext
      {
         return;
      }

      piPBotChatNext = GetTime() + Send(self,@PBotScale,#seconds=Random(60,300));

      // a chat that was not told lately
      iTry = 0;
      iNum = Random(1,Send(Nth(First(plPBotBodies),2),@ChatThreadCount));
      while iTry < 20 AND FindListElem(plPBotChatRecent,iNum) <> 0
      {
         iNum = Random(1,Send(Nth(First(plPBotBodies),2),@ChatThreadCount));
         ++iTry;
      }

      plPBotChatRecent = Cons(iNum,plPBotChatRecent);
      if Length(plPBotChatRecent) > 10
      {
         plPBotChatRecent = Cons(iNum,$);
      }

      lThread = Send(Nth(First(plPBotBodies),2),@ChatThread,#iNum=iNum);
      lA = Nth(plPBotBodies,Random(1,Length(plPBotBodies)));
      lB = lA;
      while lB = lA
      {
         lB = Nth(plPBotBodies,Random(1,Length(plPBotBodies)));
      }

      iAt = GetTime();
      iLine = 0;
      foreach i in lThread
      {
         ++iLine;
         if iLine > 1
         {
            iAt = iAt + Send(self,@PBotScale,#seconds=Random(6,12));
         }

         if iLine & 1
         {
            plPBotCast = Cons([iAt,First(lA),i],plPBotCast);
         }
         else
         {
            plPBotCast = Cons([iAt,First(lB),i],plPBotCast);
         }
      }

      return;
   }

   PBotPlaceOf(rid = 0)
   "Which town a street or inn room belongs to: 1 Tos, 2 Barloque, 3 Cor Noth, 4 Marion, 5 Raza, 6 Jasper, 7 Ko'catan, 8 Bergensdorf, 9 Jixa; 0 when it is none."
   {
      local i, iTown, t;

      iTown = 0;
      foreach t in Send(self,@NavTowns)
      {
         ++iTown;
         foreach i in Nth(t,2)
         {
            if i = rid
            {
               return iTown;
            }
         }

         foreach i in Nth(t,3)
         {
            if i = rid
            {
               return iTown;
            }
         }
      }

      return 0;
   }

   PBotSayAllowed(rid = 0)
   "One townsfolk line per room every one to two minutes (all bots together): TRUE when this room may have one now, and it starts the wait."
   {
      local i, lKeep, bOk;

      bOk = TRUE;
      lKeep = $;
      foreach i in plPBotRoomSay
      {
         if First(i) = rid
         {
            if GetTime() < Nth(i,2)
            {
               bOk = FALSE;
               lKeep = Cons(i,lKeep);
            }
         }
         else
         {
            lKeep = Cons(i,lKeep);
         }
      }

      if bOk
      {
         lKeep = Cons([rid,GetTime() + Send(self,@PBotScale,#seconds=Random(60,120))],lKeep);
      }

      plPBotRoomSay = lKeep;

      return bOk;
   }

   PBotGreetAllowed(oUser = $)
   "A player is greeted by one bot, then by none for one to five minutes: TRUE when this player may be greeted now, and it starts the wait."
   {
      local i, lKeep, bOk;

      bOk = TRUE;
      lKeep = $;
      foreach i in plPBotGreeted
      {
         if GetTime() < Nth(i,2)
         {
            lKeep = Cons(i,lKeep);
            if First(i) = oUser
            {
               bOk = FALSE;
            }
         }
      }

      if bOk
      {
         lKeep = Cons([oUser,GetTime() + Send(self,@PBotScale,#seconds=Random(60,300))],lKeep);
      }

      plPBotGreeted = lKeep;

      return bOk;
   }

   PBotHuntGiveUp(id = 0)
   "A hunter that could not find or reach a foe the rule's number of times in a row ends its hunt: its activity is over now, the next one is chosen at the next tick (PBotFinish, PBotChoose)."
   {
      if Send(self,@PBotIdentity,#id=id) = $
      {
         return;
      }

      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime());

      return;
   }

   PBotDoorsOf(rid = 0)
   "[ doors, squares, nodes, components, restricted ] of a baked room (restricted: some door cannot be reached from some arrival square, see the route search), from a cache made once per bake: NavRoom builds the whole graph from literals on every call and the server frees such lists only at its garbage collection (list node numbers run out at 2^27, 2026-10-30), so the route search must not call it per step."
   {
      local lEntry, lRoom, lDoor, bRestricted;

      if piPBotNavStamp <> Send(self,@NavVersion)
      {
         // new bake (or a first use): the cached tables are stale. The old ones are left to the server's list memory, once per bake.
         plPBotDoorCache = $;
         piPBotNavStamp = Send(self,@NavVersion);
      }

      foreach lEntry in plPBotDoorCache
      {
         // (an entry of an older format, fewer parts than now, made before the nodes or the components were added and kept in the save, is made again)
         if First(lEntry) = rid AND (Nth(lEntry,2) = $ OR Length(Nth(lEntry,2)) >= 5)
         {
            return Nth(lEntry,2);
         }
      }

      lRoom = Send(self,@NavRoom,#rid=rid);
      if lRoom = $
      {
         lEntry = [rid,$];
      }
      else
      {
         bRestricted = FALSE;
         foreach lDoor in Nth(lRoom,3)
         {
            if Nth(lDoor,10) <> $
            {
               bRestricted = TRUE;
            }
         }

         lEntry = [rid,[Nth(lRoom,3),Bound(Length(First(lRoom)) / 2,1,$),First(lRoom),Send(self,@PBotComponents,#lRoom=lRoom),bRestricted]];
      }

      plPBotDoorCache = Cons(lEntry,plPBotDoorCache);

      return Nth(lEntry,2);
   }

   PBotComponents(lRoom = $)
   "For each node of a room's graph the number of the connected piece it belongs to (nodes with the same number can walk to each other)."
   {
      local lComp, iNodes, iNode, iLabel, lFront, lNext, iCur, lEdge, iNb, lRoutes;

      iNodes = Length(First(lRoom));
      lRoutes = Nth(lRoom,2);
      lComp = $;
      iNode = iNodes;
      while iNode > 0
      {
         lComp = Cons(0,lComp);
         iNode = iNode - 1;
      }

      iLabel = 0;
      iNode = 0;
      while iNode < iNodes
      {
         ++iNode;
         if Nth(lComp,iNode) = 0
         {
            ++iLabel;
            SetNth(lComp,iNode,iLabel);
            lFront = [iNode];
            while lFront <> $
            {
               lNext = $;
               foreach iCur in lFront
               {
                  foreach lEdge in Nth(lRoutes,iCur)
                  {
                     iNb = First(lEdge);
                     if Nth(lComp,iNb) = 0
                     {
                        SetNth(lComp,iNb,iLabel);
                        lNext = Cons(iNb,lNext);
                     }
                  }
               }

               lFront = lNext;
            }
         }
      }

      return lComp;
   }

   MobHasPath(mob = $,what = $)
   "Hook in brain.kod (Brain.GetHatred, rule pbMobAggroPath): can this monster walk to this one? TRUE for a monster that attacks from afar, in a room without a graph, and when the graph has a route between the nodes nearest to them."
   {
      local oRoom, rid, lInfo, iA, iB, lComp;

      oRoom = Send(mob,@GetOwner);
      if oRoom = $ OR Send(mob,@HasRangedAttack)
      {
         return TRUE;
      }

      rid = Send(oRoom,@GetRoomNum);
      lInfo = Send(self,@PBotDoorsOf,#rid=rid);
      if lInfo = $
      {
         return TRUE;
      }

      iA = Send(self,@NavNearest,#rid=rid,#row=Send(mob,@GetRow),#col=Send(mob,@GetCol));
      iB = Send(self,@NavNearest,#rid=rid,#row=Send(what,@GetRow),#col=Send(what,@GetCol));
      lComp = Nth(lInfo,4);
      if iA = 0 OR iB = 0 OR lComp = $
      {
         return TRUE;
      }

      return Nth(lComp,iA) = Nth(lComp,iB);
   }

   PBotRouteEstimate(fromRid = 0,fromNode = 0,toRid = 0,iHealth = 1)
   "Risk-weighted room-door search constrained to survivable sprint routes. toRid 0 returns the list of reachable room numbers, toRid > 0 returns [ first door, cost, damage ] or $."
   {
      local lStates, lState, lBest, lRoomInfo, lNextInfo, lDoors, lDoor, iDoor, iBestScore, i, iRid, iNextRid, iCost, iDamage, iScore, iFirst,
         iExisting, iIterations, lResult, iArrive, iNextArrive;

      if toRid > 0 AND fromRid = toRid
      {
         return [$,0,0];
      }

      if Send(self,@PBotDoorsOf,#rid=fromRid) = $ OR (toRid > 0 AND Send(self,@PBotDoorsOf,#rid=toRid) = $)
      {
         return $;
      }

      // a state is [ room, cost, damage, first door as room * 100 + door number (0 = none yet), score, closed, arrival square (row * 1000 + col) it came in by ]:
      // the arrival square only counts in a room where some door cannot be reached from some arrival (the planner's verdict, baked into the doors), else it is 0 and one state serves the room
      lStates = [ [fromRid,0,0,0,0,FALSE,0] ];
      iIterations = 0;
      lResult = $;

      while iIterations < 500
      {
         ++iIterations;
         lBest = $;
         iBestScore = 999999;
         foreach lState in lStates
         {
            if NOT Nth(lState,6) AND Nth(lState,5) < iBestScore
            {
               lBest = lState;
               iBestScore = Nth(lState,5);
            }
         }

         if lBest = $
         {
            break;
         }

         SetNth(lBest,6,TRUE);
         iRid = First(lBest);

         if toRid > 0 AND iRid = toRid
         {
            iFirst = Nth(lBest,4);
            lDoors = First(Send(self,@PBotDoorsOf,#rid=iFirst / 100));
            lResult = [Nth(lDoors,iFirst - (iFirst / 100) * 100),Nth(lBest,2),Nth(lBest,3)];

            break;
         }

         lRoomInfo = Send(self,@PBotDoorsOf,#rid=iRid);
         if lRoomInfo = $
         {
            continue;
         }

         iDamage = Nth(lBest,3) + Send(self,@PBotRouteRoomDamage,#rid=iRid,#iSquares=Nth(lRoomInfo,2));
         if iDamage >= iHealth
         {
            continue;
         }

         iArrive = Nth(lBest,7);
         iDoor = 0;
         foreach lDoor in First(lRoomInfo)
         {
            ++iDoor;
            iNextRid = Nth(lDoor,6);
            lNextInfo = Send(self,@PBotDoorsOf,#rid=iNextRid);
            if Nth(lDoor,4) <> 1 OR lNextInfo = $
            {
               continue;
            }

            // a bot that came in on an arrival square from which this door cannot be reached does not take it
            if iArrive <> 0 AND FindListElem(Nth(lDoor,10),iArrive)
            {
               continue;
            }

            iNextArrive = 0;
            if Nth(lNextInfo,5)
            {
               iNextArrive = Nth(lDoor,7) * 1000 + Nth(lDoor,8);
            }

            iCost = Nth(lBest,2) + 1;
            iScore = iCost + iDamage * 5;
            iFirst = Nth(lBest,4);
            if iFirst = 0
            {
               iFirst = iRid * 100 + iDoor;
            }

            iExisting = $;
            foreach lState in lStates
            {
               if First(lState) = iNextRid AND Nth(lState,7) = iNextArrive
               {
                  iExisting = lState;
               }
            }

            if iExisting = $
            {
               lStates = Cons([iNextRid,iCost,iDamage,iFirst,iScore,FALSE,iNextArrive],lStates);
            }
            else if NOT Nth(iExisting,6) AND iScore < Nth(iExisting,5)
            {
               SetNth(iExisting,2,iCost);
               SetNth(iExisting,3,iDamage);
               SetNth(iExisting,4,iFirst);
               SetNth(iExisting,5,iScore);
            }
         }
      }

      if toRid = 0
      {
         foreach lState in lStates
         {
            if FindListElem(lResult,First(lState)) = 0
            {
               lResult = Cons(First(lState),lResult);
            }
         }
      }

      return lResult;
   }

   PBotRemoveIndex(lList = $,iPos = 0)
   "Remove the first matching state index from a list."
   {
      local lNew, i, bRemoved;

      lNew = $;
      bRemoved = FALSE;
      foreach i in lList
      {
         if i = iPos AND NOT bRemoved
         {
            bRemoved = TRUE;
         }
         else
         {
            lNew = Cons(i,lNew);
         }
      }

      return lNew;
   }

   PBotChatPartner(oBot = $)
   "Another bot of the same room that is standing about (not talking, not leaving), chosen at random, else $."
   {
      local oRoom, i, o, lPick;

      oRoom = Send(oBot,@GetOwner);
      lPick = $;
      foreach i in plPBotBodies
      {
         o = Nth(i,2);
         if o <> oBot AND Send(o,@GetOwner) = oRoom AND Send(o,@IsStandingAbout)
         {
            lPick = Cons(o,lPick);
         }
      }

      if lPick = $
      {
         return $;
      }

      return Nth(lPick,Random(1,Length(lPick)));
   }

   PBotIdentity(id = 0)
   {
      local i;

      foreach i in plPBotIdentities
      {
         if First(i) = id
         {
            return i;
         }
      }

      return $;
   }

   PBotIsShopping(id = 0)
   {
      local lId;

      lId = Send(self,@PBotIdentity,#id=id);
      return lId <> $ AND Nth(lId,8) = PBA_SHOP;
   }

   PBotBodyOf(id = 0)
   {
      local i;

      foreach i in plPBotBodies
      {
         if First(i) = id
         {
            return Nth(i,2);
         }
      }

      return $;
   }

   PBotGamerNames(iGender = GENDER_MALE,part = 1)
   "The gamer handles of this gender in three parts of 40 (a list literal may hold only 40): the names bots have under the rule piBotNameType 0."
   {
      if iGender = GENDER_FEMALE
      {
         if part = 1
         {
            return [ pbg_f1, pbg_f2, pbg_f3, pbg_f4, pbg_f5, pbg_f6, pbg_f7, pbg_f8, pbg_f9, pbg_f10, pbg_f11, pbg_f12, pbg_f13, pbg_f14, pbg_f15, pbg_f16, pbg_f17, pbg_f18, pbg_f19, pbg_f20, pbg_f21, pbg_f22, pbg_f23, pbg_f24, pbg_f25, pbg_f26, pbg_f27, pbg_f28, pbg_f29, pbg_f30, pbg_f31, pbg_f32, pbg_f33, pbg_f34, pbg_f35, pbg_f36, pbg_f37, pbg_f38, pbg_f39, pbg_f40 ];
         }

         if part = 2
         {
            return [ pbg_f41, pbg_f42, pbg_f43, pbg_f44, pbg_f45, pbg_f46, pbg_f47, pbg_f48, pbg_f49, pbg_f50, pbg_f51, pbg_f52, pbg_f53, pbg_f54, pbg_f55, pbg_f56, pbg_f57, pbg_f58, pbg_f59, pbg_f60, pbg_f61, pbg_f62, pbg_f63, pbg_f64, pbg_f65, pbg_f66, pbg_f67, pbg_f68, pbg_f69, pbg_f70, pbg_f71, pbg_f72, pbg_f73, pbg_f74, pbg_f75, pbg_f76, pbg_f77, pbg_f78, pbg_f79, pbg_f80 ];
         }

         if part = 3
         {
            return [ pbg_f81, pbg_f82, pbg_f83, pbg_f84, pbg_f85, pbg_f86, pbg_f87, pbg_f88, pbg_f89, pbg_f90, pbg_f91, pbg_f92, pbg_f93, pbg_f94, pbg_f95, pbg_f96, pbg_f97, pbg_f98, pbg_f99, pbg_f100, pbg_f101, pbg_f102, pbg_f103, pbg_f104, pbg_f105, pbg_f106, pbg_f107, pbg_f108, pbg_f109, pbg_f110, pbg_f111, pbg_f112, pbg_f113, pbg_f114, pbg_f115, pbg_f116, pbg_f117, pbg_f118, pbg_f119, pbg_f120 ];
         }

      }
      else
      {
         if part = 1
