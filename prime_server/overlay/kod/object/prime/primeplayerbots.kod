   PBotIsGamerName(rName = $)
   "TRUE when this name resource is one of the gamer handles."
   {
      local iGender, iPart, i;

      foreach iGender in [GENDER_FEMALE,GENDER_MALE]
      {
         iPart = 0;
         while iPart < 3
         {
            ++iPart;
            foreach i in Send(self,@PBotGamerNames,#iGender=iGender,#part=iPart)
            {
               if i = rName
               {
                  return TRUE;
               }
            }
         }
      }

      return FALSE;
   }

   PBotFixName(lId = $)
   "A character that is about to log in has a name of the other kind than the rule piBotNameType asks for (0 gamer, 1 human): it gets a new name of its gender that nobody has (the name changes as a bot logs in; a restart renames them all)."
   {
      local bGamer, rName, iTry;

      if lId = $
      {
         return;
      }

      bGamer = Send(self,@PBotIsGamerName,#rName=Nth(lId,2));
      if (piBotNameType = 0 AND bGamer) OR (piBotNameType <> 0 AND NOT bGamer)
      {
         return;
      }

      iTry = 0;
      rName = Send(self,@PBotPickName,#iGender=Nth(lId,3));
      while Send(self,@PBotNameUsed,#rName=rName) AND iTry < 60
      {
         rName = Send(self,@PBotPickName,#iGender=Nth(lId,3));
         ++iTry;
      }

      if NOT Send(self,@PBotNameUsed,#rName=rName)
      {
         SetNth(lId,2,rName);
      }

      return;
   }

   PBotPickName(iGender = GENDER_MALE)
   "A random name of this gender's: a man's name for a man, a woman's for a woman."
   {
      local lNames;

      if piBotNameType = 0
      {
         lNames = Send(self,@PBotGamerNames,#iGender=iGender,#part=Random(1,3));
      }
      else if iGender = GENDER_FEMALE
      {
         lNames = Send(self,@PBotFemaleNames,#part=Random(1,4));
      }
      else
      {
         lNames = Send(self,@PBotMaleNames,#part=Random(1,4));
      }

      return Nth(lNames,Random(1,Length(lNames)));
   }

   PBotNameUsed(rName = $)
   {
      local i;

      foreach i in plPBotIdentities
      {
         if Nth(i,2) = rName
         {
            return TRUE;
         }
      }

      return FALSE;
   }

   PBotNewIdentity()
   "A new character: a man or a woman (50/50) with a name of that gender nobody else has, a class, a start of health and ability, a home town."
   {
      local iGender, rName, iTry, iKind, lTowns, lId;

      iGender = GENDER_FEMALE;
      if Random(1,2) = 1
      {
         iGender = GENDER_MALE;
      }

      rName = Send(self,@PBotPickName,#iGender=iGender);
      iTry = 0;
      while Send(self,@PBotNameUsed,#rName=rName) AND iTry < 60
      {
         rName = Send(self,@PBotPickName,#iGender=iGender);
         ++iTry;
      }

      if Send(self,@PBotNameUsed,#rName=rName)
      {
         return $;
      }

      iKind = Random(COMPANION_WARRIOR,COMPANION_ELEMENTALIST);
      lTowns = Send(self,@PBotTowns);
      lId = [ piPBotNextId, rName, iGender, iKind, Send(self,@PBotStartLevel,#kind=iKind), Random(60,300), Nth(lTowns,Random(1,Length(lTowns))), PBA_NONE, 0, 0, Random(50,400), 0, 0 ];
      ++piPBotNextId;
      plPBotIdentities = Cons(lId,plPBotIdentities);

      return lId;
   }

   PBotLogin(id = 0)
   "The bot with this identity enters the game: a body in its home town, told to every player's who list."
   {
      local lId, oRoom, oBot, i;

      lId = Send(self,@PBotIdentity,#id=id);
      Send(self,@PBotFixName,#lId=lId);
      if lId = $ OR Send(self,@PBotBodyOf,#id=id) <> $
      {
         return;
      }

      oRoom = Send(SYS,@FindRoomByNum,#num=Nth(lId,7));
      if oRoom = $
      {
         return;
      }

      oBot = Create(&PlayerBot,#kind=Nth(lId,4),#owner=$);
      Send(oBot,@SetIdentity,#id=id,#name=Nth(lId,2),#gender=Nth(lId,3));
      Send(self,@CompApplyIdentity,#comp=oBot,#health=Nth(lId,5),#points=Nth(lId,6));
      plPBotBodies = Cons([id,oBot],plPBotBodies);
      Send(self,@PBotResume,#id=id);

      foreach i in Send(SYS,@GetUsersLoggedOn)
      {
         Send(i,@SomeoneLogon,#what=oBot);
      }

      return;
   }

   PBotLogout(id = 0)
   "The bot leaves the game: gone from every who list, its body removed."
   {
      local oBot, i, lKeep;

      oBot = Send(self,@PBotBodyOf,#id=id);
      lKeep = $;
      foreach i in plPBotBodies
      {
         if First(i) <> id
         {
            lKeep = Cons(i,lKeep);
         }
      }

      plPBotBodies = lKeep;
      if oBot = $
      {
         return;
      }

      foreach i in Send(SYS,@GetUsersLoggedOn)
      {
         Send(i,@SomeoneLogoff,#what=oBot);
      }

      Send(oBot,@Delete);

      return;
   }

   PBotSet(id = 0,pos = 1,value = 0)
   "Field pos of an identity set to value (a list is never changed in place: the list is made again)."
   {
      local i, j, lNew, lOne, n;

      lNew = $;
      foreach i in plPBotIdentities
      {
         if First(i) = id
         {
            lOne = $;
            n = 0;
            foreach j in i
            {
               ++n;
               if n = pos
               {
                  lOne = Cons(value,lOne);
               }
               else
               {
                  lOne = Cons(j,lOne);
               }
            }

            // Cons builds it backwards
            lNew = Cons(Send(self,@PBotReverse,#lList=lOne),lNew);
         }
         else
         {
            lNew = Cons(i,lNew);
         }
      }

      plPBotIdentities = lNew;

      return;
   }

   PBotReverse(lList = $)
   {
      local i, lOut;

      lOut = $;
      foreach i in lList
      {
         lOut = Cons(i,lOut);
      }

      return lOut;
   }

   PBotWalkSteps()
   "Steps a walking bot takes each tick: 1 in real time; with piBotTimeScale below 100 (testing only) that many times faster (10 steps at 10 percent, at most 20)."
   {
      return Bound(100 / Bound(piBotTimeScale,1,$),1,20);
   }

   PBotScale(seconds = 0)
   "Seconds of a bot's day, scaled by the rule piBotTimeScale (percent: 100 real time, 10 ten times as fast, for testing)."
   {
      return Bound(seconds * piBotTimeScale / 100,1,$);
   }

   PBotLimbo(id = 0)
   "Its body leaves the world (it is hunting, shopping or dead) but stays in who."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $
      {
         return;
      }

      Send(oBot,@EnterStateLimbo);
      if Send(oBot,@GetOwner) <> $
      {
         Send(oBot,@NewOwner,#what=$);
      }

      return;
   }

   PBotPlace(id = 0,rid = 0,row = 0,col = 0)
   "Its body appears in a room at a place (or the nearest free square)."
   {
      local oBot, oRoom;

      oBot = Send(self,@PBotBodyOf,#id=id);
      oRoom = Send(SYS,@FindRoomByNum,#num=rid);
      if oBot = $ OR oRoom = $
      {
         return;
      }

      if Send(oBot,@GetOwner) <> $
      {
         Send(oBot,@NewOwner,#what=$);
      }

      // a baked node can lie a square beyond the room's edge (24 of 6276 nodes, 20 rooms: the stand-ins of edge exits): a body put there cannot move at all (the room's
      // things box refuses every step), so it is put on the nearest square inside the room
      row = Bound(row,1,Send(oRoom,@GetRoomRows));
      col = Bound(col,1,Send(oRoom,@GetRoomCols));
      Send(oRoom,@NewHold,#what=oBot,#new_row=row,#new_col=col);
      Send(oBot,@EnterStateWait);
      Send(oBot,@StartLife,#rid=rid,#row=row,#col=col);

      return;
   }

   PBotPlaceNode(id = 0,rid = 0,node = 0)
   "Its body appears in a room at a node of its graph."
   {
      local lPos;

      lPos = Send(self,@NavNodePos,#rid=rid,#node=node);
      if lPos = $
      {
         return;
      }

      Send(self,@PBotPlace,#id=id,#rid=rid,#row=First(lPos),#col=Nth(lPos,2));

      return;
   }

   PBotPlaceAtDoor(id = 0,rid = 0)
   "Its body appears in a room at the outside of one of its doors (as if it had just come out of a building), else at a node."
   {
      local lRoom, lDoors, lNodes, lPos;

      lRoom = Send(self,@NavRoom,#rid=rid);
      if lRoom = $
      {
         return;
      }

      lNodes = First(lRoom);
      lDoors = Nth(lRoom,3);
      if lDoors <> $
      {
         lPos = Nth(lNodes,Nth(Nth(lDoors,Random(1,Length(lDoors))),3));
      }
      else
      {
         lPos = Nth(lNodes,Random(1,Length(lNodes)));
      }

      Send(self,@PBotPlace,#id=id,#rid=rid,#row=First(lPos),#col=Nth(lPos,2));

      return;
   }

   PBotWatched(id = 0)
   "Is a player in the room its body is in (so it must not appear or vanish before their eyes)?"
   {
      local oBot, oRoom;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $
      {
         return FALSE;
      }

      oRoom = Send(oBot,@GetOwner);

      return oRoom <> $ AND Send(oRoom,@CountHoldingHowMany,#class=&User) > 0;
   }

   PBotShopPresence(id = 0)
   "Keep a simulated shopper in limbo while its selected shop is empty; show it there when a player arrives."
   {
      local lId, oBot, oRoom, iRid;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $ OR Nth(lId,8) <> PBA_SHOP
      {
         return;
      }

      iRid = Nth(lId,12);
      oRoom = Send(SYS,@FindRoomByNum,#num=iRid);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if oRoom = $ OR oBot = $
      {
         return;
      }

      if Send(oBot,@GetOwner) = oRoom
      {
         if Send(oRoom,@CountHoldingHowMany,#class=&User) = 0
         {
            Send(self,@PBotLimbo,#id=id);
         }
      }
      else if Send(oBot,@GetOwner) = $ AND Send(oRoom,@CountHoldingHowMany,#class=&User) > 0
      {
         Send(self,@PBotPlaceAtDoor,#id=id,#rid=iRid);
      }

      return;
   }

   PBotResume(id = 0)
   "It has just come into the game (or been made again): it goes on with what it was doing, or chooses."
   {
      local lId, iAct;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return;
      }

      iAct = Nth(lId,8);
      if iAct = PBA_NONE OR GetTime() >= Nth(lId,9)
      {
         Send(self,@PBotChoose,#id=id);

         return;
      }

      Send(self,@PBotStart,#id=id,#act=iAct,#keep=TRUE);

      return;
   }

   PBotChoose(id = 0)
   "A new activity, by weight: hunting most, then the town, the inn and shopping."
   {
      local iRoll, iAct, lTowns;

      // now and then it moves to another town (so every town has some), never before a player's eyes
      if Random(1,100) <= 25 AND NOT Send(self,@PBotWatched,#id=id)
      {
         lTowns = Send(self,@PBotTowns);
         Send(self,@PBotSet,#id=id,#pos=7,#value=Nth(lTowns,Random(1,Length(lTowns))));
      }

      iRoll = Random(1,100);
      iAct = PBA_INN;
      if iRoll <= 40
      {
         iAct = PBA_HUNT;
      }
      else if iRoll <= 55
      {
         iAct = PBA_SHOP;
      }
      else if iRoll <= 80
      {
         iAct = PBA_TOWN;
      }

      Send(self,@PBotStart,#id=id,#act=iAct,#keep=FALSE);

      return;
   }

   PBotCanRoam(rid = 0)
   "A bot can hunt in a room only where it has a baked graph with room to move (three nodes or more): without one it cannot walk about the room or find its way back."
   {
      local lRoom;

      lRoom = Send(self,@NavRoom,#rid=rid);

      return lRoom <> $ AND Length(First(lRoom)) >= 3;
   }

   PBotRoomCrowd(rid = 0,id = 0)
   "How many other hunters (bots heading there or fighting there) and players are in a hunt room: farming rooms hold at most PB_MAX_HUNTERS, so a full map sends the bot elsewhere."
   {
      local i, iCount, oRoom;

      iCount = 0;
      foreach i in plPBotIdentities
      {
         if First(i) <> id AND Nth(i,8) = PBA_HUNT AND Nth(i,10) = rid
         {
            iCount = iCount + 1;
         }
      }

      oRoom = Send(SYS,@FindRoomByNum,#num=rid);
      if oRoom <> $
      {
         iCount = iCount + Send(oRoom,@CountHoldingHowMany,#class=&User);
      }

      return iCount;
   }

   PBotHuntRoom(id = 0)
   "A hunt room whose monsters suit the bot and whose shortest known nav route is survivable at sprint speed, else $."
   {
      local lId, i, lFit, iHealth, oBot, iStartRid, iStartNode, oOwner, lRoute, lRoutes, bReach;

      lId = Send(self,@PBotIdentity,#id=id);
      iHealth = Nth(lId,5);
      iStartRid = First(Nth(Send(self,@PBotRegion,#home=Nth(lId,7)),2));
      iStartNode = 1;
      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot <> $
      {
         oOwner = Send(oBot,@GetOwner);
         if oOwner <> $
         {
            iStartRid = Send(oBot,@GetNavRid);
            iStartNode = Send(oBot,@GetNavNode);
            iHealth = Send(oBot,@GetHealth);
         }
      }

      // Search once from this bot's origin and reuse the safe reachable-room
      // set for every level-appropriate hunt candidate.
      lRoutes = Send(self,@PBotRouteEstimate,#fromRid=iStartRid,#fromNode=iStartNode,#toRid=0,#iHealth=iHealth);
      lFit = $;
      foreach i in plPBotRooms
      {
         if Nth(i,2) * 100 >= iHealth * piBotHuntBandLow AND Nth(i,2) * 100 <= iHealth * piBotHuntBandHigh
            AND NOT Send(self,@PBotNightRoomClosed,#rid=First(i))
         {
            bReach = FALSE;
            foreach lRoute in lRoutes
            {
               if lRoute = First(i)
               {
                  bReach = TRUE;
               }
            }
            if bReach AND Send(self,@PBotRoomCrowd,#rid=First(i),#id=id) < PB_MAX_HUNTERS
            {
               lFit = Cons(i,lFit);
            }
         }
      }

      if lFit = $
      {
         return $;
      }

      return Nth(lFit,Random(1,Length(lFit)));
   }

   PBotStart(id = 0,act = 0,keep = FALSE)
   "Begin an activity; keep = it was already going (it has come back into the game part way through). A body a player can see does not appear or vanish: it walks to a door, or goes on where it is."
   {
      local lId, lRegion, lRooms, iEnd, oBot, bWatched, iRid, lRoom, iRoll;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return;
      }

      if act = PBA_HUNT AND NOT keep
      {
         lRoom = Send(self,@PBotHuntRoom,#id=id);
         if lRoom = $
         {
            // No hunt target has a survivable route: pick among the other
            // activities instead of retrying another hunt or waiting.
            iRoll = Random(1,60);
            if iRoll <= 15
            {
               act = PBA_SHOP;
            }
            else if iRoll <= 40
            {
               act = PBA_TOWN;
            }
            else
            {
               act = PBA_INN;
            }
         }
         else
         {
            Send(self,@PBotSet,#id=id,#pos=10,#value=First(lRoom));
         }
      }

      if act = PBA_SHOP AND NOT keep
      {
         iRid = Send(self,@PBotShopRoom,#home=Nth(lId,7));
         if iRid = $
         {
            act = PBA_TOWN;
         }
         else
         {
            Send(self,@PBotSet,#id=id,#pos=12,#value=iRid);
         }
      }

      if act <> PBA_SHOP
      {
         Send(self,@PBotSet,#id=id,#pos=12,#value=0);
      }

      if NOT keep
      {
         iEnd = GetTime() + Send(self,@PBotScale,#seconds=Random(300,1800));
         if act = PBA_SHOP
         {
            iEnd = GetTime() + Send(self,@PBotScale,#seconds=Random(60,240));
         }

         Send(self,@PBotSet,#id=id,#pos=8,#value=act);
         Send(self,@PBotSet,#id=id,#pos=9,#value=iEnd);
      }

      oBot = Send(self,@PBotBodyOf,#id=id);
      bWatched = Send(self,@PBotWatched,#id=id);

      if act = PBA_HUNT
      {
         // it goes there on its own two feet, seen by anyone it passes
         Send(self,@PBotTravel,#id=id,#rid=Nth(Send(self,@PBotIdentity,#id=id),10));

         return;
      }

      if act = PBA_HUNT OR act = PBA_SHOP
      {
         if bWatched
         {
            Send(oBot,@Leave);

            return;
         }

         Send(self,@PBotLimbo,#id=id);

         return;
      }

      lRegion = Send(self,@PBotRegion,#home=Nth(lId,7));
      if act = PBA_INN
      {
         lRooms = Nth(lRegion,3);
      }
      else
      {
         lRooms = Nth(lRegion,2);
      }

      iRid = Nth(lRooms,Random(1,Length(lRooms)));

      // away from its town (back from a hunt): it walks home
      if oBot <> $ AND Send(self,@PBotAwayFromTown,#oBot=oBot,#home=Nth(lId,7))
      {
         Send(self,@PBotTravel,#id=id,#rid=iRid);

         return;
      }

      if bWatched
      {
         if act = PBA_INN
         {
            Send(oBot,@Want,#what=1);
         }
         else
         {
            Send(oBot,@Want,#what=2);
         }

         return;
      }

      Send(self,@PBotPlaceAtDoor,#id=id,#rid=iRid);

      return;
   }

   PBotAwayFromTown(oBot = $,home = 0)
   "Is the place its body last stood (in the world or in limbo) outside its home town's rooms?"
   {
      local lRegion, iRid, i;

      iRid = Send(oBot,@GetNavRid);
      if iRid = 0
      {
         return FALSE;
      }

      lRegion = Send(self,@PBotRegion,#home=home);
      foreach i in Nth(lRegion,2)
      {
         if i = iRid
         {
            return FALSE;
         }
      }

      foreach i in Nth(lRegion,3)
      {
         if i = iRid
         {
            return FALSE;
         }
      }

      return TRUE;
   }

   PBotTravel(id = 0,rid = 0)
   "Its body walks to a room: from where it stands, or from where it was last (a bot out of the world is set down at a door there, or in its home town if it has no place yet)."
   {
      local oBot, lId, iFrom, lRegion;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $ OR rid = 0
      {
         return;
      }

      if Send(oBot,@GetOwner) = $
      {
         lId = Send(self,@PBotIdentity,#id=id);
         iFrom = Send(oBot,@GetNavRid);
         if iFrom = 0 OR Send(self,@NavRoom,#rid=iFrom) = $
         {
            lRegion = Send(self,@PBotRegion,#home=Nth(lId,7));
            iFrom = First(Nth(lRegion,2));
         }

         Send(self,@PBotPlaceAtDoor,#id=id,#rid=iFrom);
      }

      Send(oBot,@Journey,#rid=rid);

      return;
   }

   PBotJourneyEnd(id = 0,rid = 0)
   "Its body has come to the room it was travelling to: a hunter begins to hunt there."
   {
      local lId, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if lId <> $ AND oBot <> $ AND Nth(lId,8) = PBA_HUNT AND Nth(lId,10) = rid
      {
         Send(oBot,@BeginHunt);
      }

      return;
   }

   PBotJourneyFailed(id = 0,rid = 0)
   "No survivable route: a hunter goes back to the inn on foot; a bot with no way on casts Rescue (never a jump to where it wanted to go)."
   {
      local lId, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return;
      }

      Debug("PBOT-FAIL journey: no route, bot",id,"act",Nth(lId,8),"to room",rid,"from room",Send(Send(self,@PBotBodyOf,#id=id),@GetNavRid),"node",Send(Send(self,@PBotBodyOf,#id=id),@GetNavNode),"health",Send(Send(self,@PBotBodyOf,#id=id),@GetHealth));
      if Nth(lId,8) = PBA_HUNT AND Nth(lId,10) = rid
      {
         // no way there after all: no invisible pretend hunt, the bot goes back to the inn (it walks home, or is set down there)
         Send(self,@PBotStart,#id=id,#act=PBA_INN,#keep=FALSE);

         return;
      }

      // no way on at all (not even home on foot): it is truly stuck, so it casts Rescue like any stuck bot; no jump to where it wanted to go
      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot <> $
      {
         Send(oBot,@CastRescue);
      }

      return;
   }

   PBotHuntPresence(id = 0)
   "Real hunting: a hunter stays in the world in its hunting room (PlayerBot.HuntStep fights); nothing to do here."
   {
      return;
   }

   PBotDied(id = 0)
   "Beaten in the world: for a while in the underworld (out of the world), then back in its home town."
   {
      local oBot;

      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot = $ OR Send(self,@PBotIdentity,#id=id) = $
      {
         return;
      }

      Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_DEAD);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + Random(1500,2100));
      Send(self,@PBotSet,#id=id,#pos=10,#value=0);
      Send(oBot,@GainHealthNormal,#amount=99999,#precision=FALSE);
      Send(oBot,@ResetLocation);
      // a real body in the real underworld; the portal takes it back (PlayerBot.EnterUnderworld / PBotRevived)
      Send(self,@PBotPlace,#id=id,#rid=RID_UNDERWORLD,#row=24,#col=16);
      Send(oBot,@EnterUnderworld);

      return;
   }

   PBotRevived(id = 0)
   "Through the portal and out of the underworld: back among the living, in an inn, a little poorer."
   {
      local lId;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return;
      }

      Send(self,@PBotSet,#id=id,#pos=11,#value=Nth(lId,11) * 9 / 10);
      Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_NONE);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + Random(20,60));

      return;
   }

   PBotAddLoot(id = 0,gold = 0,reagents = 0)
   "A hunter picked something up: gold and reagent counts are all a character keeps of its loot (the items themselves are cleared away)."
   {
      local lId;

      lId = Send(self,@PBotIdentity,#id=id);
      if lId = $
      {
         return;
      }

      if gold > 0
      {
         Send(self,@PBotSet,#id=id,#pos=11,#value=Nth(lId,11) + gold);
      }

      if reagents > 0
      {
         Send(self,@PBotSet,#id=id,#pos=13,#value=Nth(lId,13) + reagents);
      }

      return;
   }

   PBotFinish(id = 0)
   "The activity is over: what it brought, what it cost."
   {
      local lId, iAct, iSecs, iLevel, iHealth, iGold, iDanger, iChance, i, iRoomLevel, iKills, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      iAct = Nth(lId,8);
      iHealth = Nth(lId,5);
      iGold = Nth(lId,11);

      if iAct = PBA_DEAD
      {
         // back from the underworld, in basic gear, a little poorer
         Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_NONE);

         return;
      }

      if iAct = PBA_SHOP
      {
         // Shopping is an abstract social activity; no shopkeeper transaction occurs.
         return;
      }

      if iAct <> PBA_HUNT
      {
         return;
      }

      iRoomLevel = iHealth;
      foreach i in plPBotRooms
      {
         if First(i) = Nth(lId,10)
         {
            iRoomLevel = Nth(i,2);
         }
      }

      // its length in minutes (as the game's clock counts it, not scaled)
      iSecs = Bound(Nth(lId,9) - GetTime(),0,$);
      iDanger = iRoomLevel * 100 / Bound(iHealth,1,$);
      // (deaths are real now: PlayerBot.Killed -> PBotDied)
      iChance = 0;

      if Random(1,100) <= iChance
      {
         // beaten: it is in the underworld a while, and has lost some of what it carried
         Send(self,@PBotSet,#id=id,#pos=11,#value=iGold * 7 / 10);
         Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_DEAD);
         Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + Send(self,@PBotScale,#seconds=Random(300,900)));
         Send(self,@PBotLimbo,#id=id);

         return;
      }

      // what it earned came in as it hunted (PBotAddLoot); the foes it really beat decide how it grew
      iKills = 0;
      oBot = Send(self,@PBotBodyOf,#id=id);
      if oBot <> $
      {
         iKills = Send(oBot,@GetHuntKills);
      }

      if Random(1,100) <= Bound(iKills * 5,0,75) AND Send(self,@PBotMayRise,#id=id)
      {
         Send(self,@PBotSet,#id=id,#pos=5,#value=Bound(iHealth + 1,20,Send(self,@PBotCap,#kind=Nth(lId,4))));
      }
      Send(self,@PBotSet,#id=id,#pos=6,#value=Bound(Nth(lId,6) + Bound(iKills / 3,0,6),0,900));

      // veterans move on now and then, so the top of the world stays rare
      if Send(self,@PBotBand,#health=iHealth,#kind=Nth(lId,4)) = 4 AND Random(1,15) = 1
      {
         Send(self,@PBotRetire,#id=id);
      }

      return;
   }

   PBotTestHunt(id = 0,rid = 0,hp = 0)
   "Test driver (scripts/bot_scenarios.py): the bot is made a hunter of room rid for two hours, set down in its home town (health raised to hp when hp > 0) and sent on its way on foot."
   {
      local lId, oBot, lRegion;

      lId = Send(self,@PBotIdentity,#id=id);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if lId = $ OR oBot = $
      {
         return FALSE;
      }

      if hp > 0
      {
         Send(self,@PBotSet,#id=id,#pos=5,#value=hp);
         Send(self,@CompApplyIdentity,#comp=oBot,#health=hp,#points=Nth(lId,6),#nocap=TRUE);
      }

      Send(oBot,@GainHealthNormal,#amount=99999,#precision=FALSE);
      Send(oBot,@SetStrict,#value=TRUE);
      Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_HUNT);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + 7200);
      Send(self,@PBotSet,#id=id,#pos=10,#value=rid);
      Send(oBot,@ResetLocation);
      lRegion = Send(self,@PBotRegion,#home=Nth(lId,7));
      Send(self,@PBotPlaceAtDoor,#id=id,#rid=First(Nth(lRegion,2)));
      Send(self,@PBotTravel,#id=id,#rid=rid);
      Debug("PBOT-TEST hunt start: bot",id,"to room",rid,"health",Send(oBot,@GetHealth));

      return TRUE;
   }

   PBotRescueHome(id = 0)
   "A bot that cannot get out of a room (the stuck rule of PlayerBot.GiveUp): like the spell Rescue, which any class may use for this, it is taken home to an inn of its home town."
   {
      local lId, lRegion, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if lId = $ OR oBot = $
      {
         return;
      }

      lRegion = Send(self,@PBotRegion,#home=Nth(lId,7));
      Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_NONE);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + Random(20,60));
      Send(self,@PBotSet,#id=id,#pos=10,#value=0);
      Send(oBot,@ResetLocation);
      Send(self,@PBotPlaceAtDoor,#id=id,#rid=First(Nth(lRegion,3)));

      return;
   }

   PBotTestHuntHere(id = 0,rid = 0,hp = 0)
   "Test driver: like PBotTestHunt but the bot is set down at a door of the hunt room itself and begins to hunt at once (the fight is tested apart from the way there)."
   {
      local lId, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if lId = $ OR oBot = $ OR Send(self,@NavRoom,#rid=rid) = $
      {
         return FALSE;
      }

      if hp > 0
      {
         Send(self,@PBotSet,#id=id,#pos=5,#value=hp);
         Send(self,@CompApplyIdentity,#comp=oBot,#health=hp,#points=Nth(lId,6),#nocap=TRUE);
      }

      Send(oBot,@GainHealthNormal,#amount=99999,#precision=FALSE);
      Send(oBot,@SetStrict,#value=TRUE);
      Send(self,@PBotSet,#id=id,#pos=8,#value=PBA_HUNT);
      Send(self,@PBotSet,#id=id,#pos=9,#value=GetTime() + 7200);
      Send(self,@PBotSet,#id=id,#pos=10,#value=rid);
      Send(oBot,@ResetLocation);
      Send(self,@PBotPlaceAtDoor,#id=id,#rid=rid);
      Send(oBot,@BeginHunt);
      Debug("PBOT-TEST hunt-here start: bot",id,"room",rid);

      return TRUE;
   }

   PBotTestPlace(id = 0,rid = 0,row = 0,col = 0,hp = 0)
   "Test driver (TEST ONLY, never used by a running bot): the bot is set down at a square of a room with so much health that nothing can kill it (not an admin flag: just health), its way points cleared."
   {
      local lId, oBot;

      lId = Send(self,@PBotIdentity,#id=id);
      oBot = Send(self,@PBotBodyOf,#id=id);
      if lId = $ OR oBot = $ OR Send(self,@NavRoom,#rid=rid) = $
      {
         return FALSE;
      }

      if hp > 0
      {
         Send(self,@PBotSet,#id=id,#pos=5,#value=hp);
         Send(self,@CompApplyIdentity,#comp=oBot,#health=hp,#points=Nth(lId,6),#nocap=TRUE);
      }

      Send(oBot,@GainHealthNormal,#amount=999999,#precision=FALSE);
      Send(oBot,@SetStrict,#value=TRUE);
      Send(oBot,@StopMoving);
      Send(oBot,@ResetLocation);
      Send(self,@PBotPlace,#id=id,#rid=rid,#row=row,#col=col);

      return TRUE;
   }

