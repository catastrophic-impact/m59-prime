// Meridian 59 Prime: the playerbots' registry (PrimePlayerBots, a layer of the Prime singleton). A playerbot is a persistent identity (name, gender, class,
// health, ability percent, home town) with, while it is "logged in", a body (PlayerBot, the Companion body with no owner). They appear in "who" and answer
// tells like players. Phase 1: a few bots log in, stand and walk about town squares, speak now and then, and come and go. Rules (PrimeRules):
// piTownLife (0 townsfolk crowds, 1 playerbots, 2 both), piPlayerBotCount (how many are logged in at once).

PrimePlayerBots is PrimeNavData

constants:

   include blakston.khd
   include protocol.khd
   include prime.khd

   // What a playerbot is doing (identity field 8)
   PBA_NONE = 0
   PBA_TOWN = 1
   PBA_INN = 2
   PBA_HUNT = 3
   PB_MAX_HUNTERS = 3
   PBA_SHOP = 4
   PBA_DEAD = 5

resources:

   pbc_cooldown = "You must wait a few seconds before you broadcast again."

   // Info window of a bot that is away (the first four %s are the description parts and the class of its body, see PlayerBot.ShowDesc)
   pbr_hunt = "%s %s %s\n\nClass: %s.\nCurrently: farming %s in %s."
   pbr_shop = "%s %s %s\n\nClass: %s.\nCurrently: out shopping around %s."
   pbr_dead = "%s %s %s\n\nClass: %s.\nCurrently: in the underworld, waiting to come back to %s."

