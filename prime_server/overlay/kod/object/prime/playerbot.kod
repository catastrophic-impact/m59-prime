   pbot_ouch_m2 = ouchm2.ogg
   pbot_ouch_m3 = ouchm3.ogg
   pbot_ouch_m4 = ouchm4.ogg
   pbot_ouch_f1 = ouchf1.ogg
   pbot_ouch_f2 = ouchf2.ogg
   pbot_ouch_f3 = ouchf3.ogg
   pbot_ouch_f4 = ouchf4.ogg
