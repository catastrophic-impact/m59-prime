   pbot_greet2 = "Good day to you."
   pbot_greet3 = "Hello there."
   pbot_greet4 = "Fine weather for a walk."
   pbot_greet5 = "Mind how you go."
   pbot_chat1 = "The roads are quiet today."
   pbot_chat2 = "I could do with a rest at the inn."
   pbot_chat3 = "Anyone seen a good trader about?"
   pbot_chat4 = "The mummies in the crypt are stirring again, they say."
   pbot_chat5 = "My sword wants sharpening."
   pbot_chat6 = "I have been out hunting since dawn."
   pbot_chat7 = "Watch yourself near the graveyard."
   pbot_chat8 = "Prices are not what they were."
   pbot_reply1 = "Hello! I cannot talk long, I am busy right now."
   pbot_reply2 = "Hm? Good to hear from you. Find me in town some time."
   pbot_reply3 = "Sorry, I am in the middle of something. Another time?"
   pbot_reply4 = "Well met. I am not much for conversation today."
   pbot_reply5 = "Thanks for the word. Safe travels!"

   pbd_look1 = "A broad-shouldered traveler with a sun-browned face."
   pbd_look2 = "Slight and quick-eyed, with ink-stained fingers."
   pbd_look3 = "Tall and lean, a faded scar running along one jaw."
   pbd_look4 = "Round-faced and rosy, dressed for a long road."
   pbd_look5 = "Grey streaks in the hair and a patient, watchful gaze."
   pbd_look6 = "A well-worn pack and boots that have seen many roads."
   pbd_look7 = "Neatly kept, with a polished buckle and a careful smile."
   pbd_look8 = "Wind-tousled and freckled, grinning at nothing in particular."
   pbd_look9 = "Dark eyes under a heavy brow; not easily startled."
   pbd_look10 = "Muddy to the knees and quite unbothered by it."
   pbd_look11 = "Stands like someone who once drilled with the town guard."
   pbd_look12 = "A weathered cloak patched in three different colours."
   pbd_look13 = "Bright-eyed and restless, forever shifting from foot to foot."
   pbd_look14 = "Steady hands, calloused from rope and steel."
   pbd_look15 = "A crooked nose, badly healed, above a very good-natured smile."
   pbd_look16 = "Plainly dressed, but the blade at the hip is cared for."
   pbd_look17 = "Soft-spoken, with a tired look around the eyes."
   pbd_look18 = "A little sunburnt and smelling faintly of woodsmoke."
   pbd_look19 = "Keeps glancing at the sky as if reading the weather."
   pbd_look20 = "Hair tied back with a scrap of green ribbon."
   pbd_manner1 = "Friendly enough, but quick to change the subject when asked about the past."
   pbd_manner2 = "Listens far more than speaking."
   pbd_manner3 = "Laughs easily and loudly, and is forgiven for it."
   pbd_manner4 = "Cautious with strangers, generous with friends."
   pbd_manner5 = "Always seems to be counting something under the breath."
   pbd_manner6 = "Hums old tavern songs, mostly off key."
   pbd_manner7 = "Fond of a wager, if the odds are reasonable."
   pbd_manner8 = "Tells tall tales about monsters that grow with each telling."
   pbd_manner9 = "Dry humour and a slow, deliberate way of talking."
   pbd_manner10 = "Never passes a stray cat without a kind word."
   pbd_manner11 = "Prefers the company of a good map to the company of a crowd."
   pbd_manner12 = "Collects rumours and trades them like coin."
   pbd_manner13 = "Careful about prices and quick to haggle."
   pbd_manner14 = "Proud of the gear on display, and polite about it."
   pbd_manner15 = "Brisk and businesslike, always a little behind schedule."
   pbd_manner16 = "Quietly devout, with a small holy symbol tucked under the collar."
   pbd_manner17 = "Gruff on the outside, a soft touch underneath."
   pbd_manner18 = "Curious about everything and everyone."
   pbd_manner19 = "Takes a long time to answer, and means every word."
   pbd_manner20 = "Whistles when nervous, and is nervous surprisingly often."
   pbd_back1 = "Grew up near Marion and still misses the quiet of the fields."
   pbd_back2 = "Has worked the docks at Barloque, and it shows in the arms."
   pbd_back3 = "Learned the trade from an old sword-for-hire who never gave a name."
   pbd_back4 = "Left a family farm to see the world, and has seen most of it twice."
   pbd_back5 = "Once guarded a merchant caravan all the way to Cor Noth."
   pbd_back6 = "Studied a while with a hedge wizard before taking to the road."
   pbd_back7 = "Saving for a house in Jasper, one coin at a time."
   pbd_back8 = "Owes the Tos blacksmith a favour and has not forgotten."
   pbd_back9 = "Has a brother somewhere in Ko'catan and writes when able."
   pbd_back10 = "Sailed in once from the southern islands with nothing but a bedroll."
   pbd_back11 = "Spent a winter in Raza, and speaks of it with great fondness."
   pbd_back12 = "Fought through the mummies of the old crypt and lived to boast."
   pbd_back13 = "Hunts for the pleasure of it and sells what the hunt provides."
   pbd_back14 = "Keeps a journal of every road walked."
   pbd_back15 = "Was a baker's apprentice once and can still bake a fine loaf."
   pbd_back16 = "Wants to be remembered in the songs, whatever it takes."
   pbd_back17 = "Fled a bad bargain in the city and found a better life out here."
   pbd_back18 = "Looks after a retired war-horse stabled on the edge of town."
   pbd_back19 = "Trained in the arena, and has stories about it."
   pbd_back20 = "Came to Meridian looking for a lost sibling and stayed for the people."
   pbot_talk1 = "Did you hear? Something stirs in the old crypt again."
   pbot_talk2 = "I swear the prices at the smithy go up every week."
   pbot_talk3 = "Have you tried the stew here? Better than yesterday's."
   pbot_talk4 = "I took a bad fall in the caves last week, still limping."
   pbot_talk5 = "They say the next full moon brings trouble."
   pbot_talk6 = "I could use a good night's sleep for once."
   pbot_talk7 = "Mind the roads after dark, my friend."
   pbot_talk8 = "I heard a new trader set up shop by the gate."
   pbot_talk9 = "My boots are ruined, and the cobbler wants a fortune."
   pbot_talk10 = "Quiet today, is it not?"
   pbot_talk11 = "I met a fine adventurer on the road, they shared their water."
   pbot_talk12 = "My pack has never felt heavier."
   pbot_talk13 = "I miss the old days, when the roads were safer."
   pbot_talk14 = "Anyone know a good place to hunt for a few hours?"
   pbot_talk15 = "I once saw a troll the size of a cottage, I swear."
   pbot_talk16 = "Is it me, or is it getting colder each evening?"
   pbot_talk17 = "I owe a drink to a friend, if I can find them."
   pbot_talk18 = "That armor looks like fine work. Where did you get it?"
   pbot_talk19 = "I am saving up for a better blade."
   pbot_talk20 = "Well, I should not keep you. Safe roads!"
   pbot_talk21 = "True enough. It was good to talk."
   pbot_talk22 = "Ha! I will remember that one."
   pbot_talk23 = "I had better be going soon. Take care."
   pbot_talk24 = "You always say that, and you are always right."
