// Meridian 59 Prime: a playerbot's body. The Companion body (fighting, gear, looks, numbers from PrimeCompanions) with no owner: a persistent character that
// lives in the world, shows in "who", answers tells and lives a town life. Its identity (name, gender, class, numbers) is kept by PrimePlayerBots; this object
// is only its body while it is "logged in". Town life uses the baked graphs of PrimeNavData (nodes, doors) to choose where to go; the way there is its own: it plans a
// path over the room's real floor (the server's A*, WalkTo) and walks it one step a tick like a player (PathStep). The registry (PrimePlayerBots) chooses the activity and where; this body only carries it out.
// STATE MODEL: piDoing says what it is doing (and what its info window shows), piPhase how it is doing it right now (PBH_IDLE: standing, PBH_WALK:
// walking the planner's way, PBH_TALK: in a talk). Every route to standing still goes through StopMoving, every walk starts in GoToNode / GoToDoor, and
// every walk ends in Arrived, GiveUp or an interruption (StopMoving), so no state is left half set. A relaxed bot parks at a spot and only turns
// to look about; the registry's activity timer, not a local timer, decides when it goes somewhere. What it is doing is shown in its info window while piBotShowDoing is on.

PlayerBot is Companion

constants:

   include blakston.khd
   include protocol.khd
   include prime.khd
   HUMAN_TRANSLATION_LEGS_MASK = 0xff
   HUMAN_TRANSLATION_LEGS_MUL = 1
   HUMAN_TRANSLATION_BODY_MASK = 0xff00
   HUMAN_TRANSLATION_BODY_MUL = 0x100


   // Pace (squares per 10 s, see Monster.GetMoveTime). It walks (viSpeed, the companions' pace) unless in danger; then it runs at half a
   // player's sprint: halfway between walking and the companion's full run. Grouped, it runs as fast as the group's leader (Companion).
   PB_PANIC_SPEED = 34
   // fine units a walking bot moves per WalkStep tick: 16, the step width of the server's own monster walk (Monster.GetMoveTime: 16 fine units every 10000 / (speed * 4) ms). The client animates each step at the pace of the speed it is given, so any other step size makes it stop and go (11 did, 2026-10-31)
   PB_WALK_STEP = 16
   // TRAVEL BODY RADIUS (roo units, 1024 = one square): a bot that walks like a player is blocked by creatures and other bots only within this (the client's 0.25 square), not the server's 0.75 monster rule (owner decision 2026-11-01)
   PB_TRAVEL_BODY_RADIUS = 256
   // a walk that gets no measurably closer to its goal for this many ticks (150 ms each) is given up (GiveUp): 200 = 30 seconds; going round a wall or a creature takes a while
   PB_WALK_STALL_TICKS = 200

   // What it is doing (piDoing; the info window's "Currently")
   PBD_IDLE = 1
   PBD_HANG = 2
   PBD_WALK = 3
   PBD_ERRAND = 4
   PBD_TALK = 5
   PBD_TRANSIT = 6
   PBD_GLOBE = 7
   PBD_LEAVE = 8
   PBD_INN = 9
   PBD_SHOP = 10
   PBD_HUNT = 11
   PBD_DEAD = 12

   // Its phase: standing until piPhaseEnd, walking its path, or in a talk
   PBH_IDLE = 0
   PBH_WALK = 1
   PBH_TALK = 2

   // What a parked bot is up to in a street or inn (piMood): hanging about (a look now and then, a word rarely), reading the globe, away from
   // the keyboard (stands still, never turns), or chatty
   PBM_NORMAL = 0
   PBM_GLOBE = 1
   PBM_AFK = 2
   PBM_CHAT = 3

   // What the registry wants of it (piWant): nothing, to be in an inn, to be in the street
   PBW_NONE = 0
   PBW_INN = 1
   PBW_STREET = 2

   // Purpose numbers of doors (navbake.ts)
   PBP_BANK = 1
   PBP_SMITH = 2
   PBP_APOTH = 3
   PBP_HALL = 4
   PBP_STORE = 5
   PBP_HEAL = 6

